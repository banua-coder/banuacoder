---
import { getCollection } from 'astro:content'
import CaseStudyDetail from '../../components/portfolio/CaseStudyDetail.astro'

export async function getStaticPaths() {
  const entries = await getCollection('portfolio', ({ data }) => !data.draft && data.locale === 'id')
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }))
}

const { entry } = Astro.props
---

<CaseStudyDetail entry={entry} locale="id" />
