---
import { getCollection } from 'astro:content'
import BlogPost from '../../../components/pages/BlogPost.astro'

export async function getStaticPaths() {
  const posts = (await getCollection('blog'))
    .filter((p) => p.data.locale === 'en' && !p.data.draft)
    .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  return posts.map((entry, i) => ({
    params: { slug: entry.data.slug },
    props: { entry, prevEntry: posts[i + 1] ?? null, nextEntry: posts[i - 1] ?? null },
  }))
}

const { entry, prevEntry, nextEntry } = Astro.props
---

<BlogPost entry={entry} prevEntry={prevEntry} nextEntry={nextEntry} locale="en" />
