---
import { getCollection } from 'astro:content'
import { ogUrl } from '../../lib/og/url'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Nav from '../../components/layout/Nav.astro'
import HomeBody from '../../components/sections/HomeBody.astro'
import Footer from '../../components/layout/Footer.astro'



// Load home EN copy
const allPages = await getCollection('pages')
// Astro glob loader slugifies filenames: home.en.mdx -> 'homeen'
const homePage = allPages.find(
  (p) => p.id === 'homeen' || p.id === 'home.en' || (p.data.locale === 'en' && p.id.startsWith('home')),
)
if (!homePage) throw new Error('home EN page entry not found in pages collection')



// JSON-LD Organization schema — extended per M7 schema audit
const orgSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Organization', 'ProfessionalService'],
      '@id': 'https://banuacoder.com/#organization',
      name: 'Banua Coder',
      url: 'https://banuacoder.com',
      logo: 'https://banuacoder.com/favicon.svg',
      sameAs: [
        'https://linkedin.com/company/banuacoder',
        'https://github.com/banua-coder',
        'https://instagram.com/banuacoder',
        'https://youtube.com/@banuacoder',
      ],
      foundingDate: '2019',
      description:
        'Engineering-led technology partner helping F&B brands, beauty businesses, and regional governments build relevant, scalable digital solutions.',
      slogan: 'Engineering-led. Built to last.',
      priceRange: '$$',
      email: 'contact@banuacoder.com',
      telephone: '+6287784808269',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Palu',
        addressRegion: 'Central Sulawesi',
        postalCode: '94111',
        addressCountry: 'ID',
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: -0.8917,
        longitude: 119.8707,
      },
      areaServed: [
        { '@type': 'Country', name: 'Indonesia' },
        { '@type': 'City', name: 'Palu' },
        { '@type': 'AdministrativeArea', name: 'Central Sulawesi' },
        'ID',
      ],
      knowsAbout: [
        'Mobile App Development',
        'Flutter',
        'Laravel',
        'Public Sector Digitalization',
        'Membership Systems',
        'F&B Technology',
        'Operational Systems',
        'UI/UX Design',
      ],
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'customer service',
        telephone: '+6287784808269',
        availableLanguage: ['Indonesian', 'English'],
        hoursAvailable: {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
          opens: '09:00',
          closes: '17:00',
        },
      },
      founder: {
        '@type': 'Person',
        '@id': 'https://banuacoder.com/founder/#person',
        name: 'Fajrian Aidil Pratama',
        url: 'https://banuacoder.com/founder/',
      },
    },
    {
      '@type': 'WebSite',
      '@id': 'https://banuacoder.com/#website',
      url: 'https://banuacoder.com',
      name: 'Banua Coder',
      inLanguage: ['id', 'en'],
      publisher: { '@id': 'https://banuacoder.com/#organization' },
    },
  ],
}
---

<BaseLayout title={homePage.data.title} description={homePage.data.description} ogImage={ogUrl('en-home')}>
  <!-- JSON-LD Organization -->
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(orgSchema)} />

  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[9999] focus:px-4 focus:py-2 focus:bg-bnc-primary focus:text-white focus:rounded-[var(--radius-sm)]"
  >
    Skip to main content
  </a>

  <Nav />

  <main id="main-content">
    <HomeBody locale="en" data={homePage.data} />
  </main>

  <Footer />
</BaseLayout>
