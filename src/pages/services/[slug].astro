---
import { getCollection } from 'astro:content'
import ServiceDetail from '../../components/services/ServiceDetail.astro'

export async function getStaticPaths() {
  const all = await getCollection('services')
  return all
    .filter((s) => s.data.locale === 'id')
    .map((svc) => ({ params: { slug: svc.data.slug }, props: { entry: svc } }))
}

const { entry } = Astro.props
---

<ServiceDetail entry={entry} locale="id" />
