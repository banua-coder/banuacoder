---
import BaseLayout from '../layouts/BaseLayout.astro'
import Nav from '../components/layout/Nav.astro'
import Footer from '../components/layout/Footer.astro'
import Container from '../components/layout/Container.astro'

const link = 'underline underline-offset-4 decoration-1 hover:decoration-2 focus-visible:decoration-2'
---

<BaseLayout
  title="404: Halaman tidak ditemukan · Banua Coder"
  description="Halaman yang Anda cari tidak ditemukan. Kembali ke beranda atau jelajahi portfolio kami."
  indexable={false}
>
  <Nav />

  <main id="main-content">
    <section aria-labelledby="not-found-heading" class="plate relative overflow-hidden min-h-[100svh] flex items-end" style="padding-top: 8rem; padding-bottom: var(--spacing-section-y-sm)">
      <div aria-hidden="true" class="numeral absolute right-[-3vw] bottom-[-4vw]" data-parallax="0.1">404</div>
      <Container class="relative">
        <p class="folio text-bnc-accent border-t border-current/25 pt-3">№ 404 / Not found</p>
        <h1 id="not-found-heading" class="display mt-10 text-balance" style="font-size: var(--fs-84); max-width: 12ch">Halaman tidak ditemukan</h1>
        <p class="mute mt-8 leading-relaxed" style="font-size: var(--fs-20); max-width: 52ch">
          Halaman yang Anda cari mungkin sudah dipindahkan, dihapus, atau tidak pernah ada.
        </p>
        <p class="mute mt-2 leading-relaxed" style="font-size: var(--fs-17); max-width: 52ch" lang="en">
          The page you're looking for may have moved, been removed, or never existed.
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a href="/" class="inline-flex items-center gap-2 bg-white text-bnc-plate font-semibold px-7 py-3.5 hover:bg-bnc-accent hover:text-bnc-ink transition-colors duration-150">Kembali ke beranda <span aria-hidden="true">→</span></a>
          <a href="/portfolio/" class="inline-flex items-center border border-white text-white font-medium px-7 py-3.5 hover:bg-white hover:text-bnc-plate transition-colors duration-150">Lihat portfolio</a>
          <a href="/contact/" class={`${link} px-2 py-3.5`}>Hubungi kami</a>
        </div>
      </Container>
    </section>
  </main>

  <Footer />
</BaseLayout>
