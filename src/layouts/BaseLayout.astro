---
import '../styles/global.css'
import { ClientRouter } from 'astro:transitions'

import { contact } from '../data/contact'

interface Props {
  title: string
  description?: string
  /** Absolute or site-relative OG image. Defaults to the /og/<slug>.png derived from the route. */
  ogImage?: string
  ogImageAlt?: string
  /** Set to false only for noindex pages like /dev/components */
  indexable?: boolean
  /** og:type. Use 'article' for blog posts. */
  type?: 'website' | 'article'
  /** ISO dates, article only */
  publishedTime?: string
  modifiedTime?: string
  tags?: string[]
}

const {
  title,
  description = 'Banua Coder — Technology partner for websites, apps, and operational systems.',
  ogImage,
  ogImageAlt,
  indexable = true,
  type = 'website',
  publishedTime,
  modifiedTime,
  tags = [],
} = Astro.props

const locale = Astro.currentLocale ?? 'id'
const isEn = locale === 'en'

// Build alternate hreflang URLs
const currentPath = Astro.url.pathname
const idPath = isEn ? currentPath.replace(/^\/en(?=\/|$)/, '') || '/' : currentPath
const enPath = isEn ? currentPath : `/en${currentPath === '/' ? '' : currentPath}`
const idUrl = new URL(idPath, Astro.site).href
const enUrl = new URL(enPath, Astro.site).href

// Detect /dev/ routes to force noindex
const isDevRoute = currentPath.startsWith('/dev/')
const shouldIndex = indexable && !isDevRoute

// Route → OG slug (mirrors src/pages/og/[...slug].png.ts): /en/blog/x/ → en-blog-x, / → home
const OG_SECTIONS = ['about', 'founder', 'contact', 'estimate', 'portfolio', 'services', 'blog']
const segs = idPath.split('/').filter(Boolean)
const ogSlugBase = segs.length === 0 ? 'home' : OG_SECTIONS.includes(segs[0]) ? segs.join('-') : 'home'
const ogPath = ogImage ?? `/og/${isEn ? 'en-' : ''}${ogSlugBase}.png`
const ogAbs = new URL(ogPath, Astro.site).href
const ogAlt = ogImageAlt ?? title
const canonical = Astro.url.href.split('?')[0].split('#')[0]

const siteUrl = new URL('/', Astro.site).href
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': `${siteUrl}#organization`,
      name: 'Banua Coder',
      url: siteUrl,
      logo: new URL('/favicon.svg', Astro.site).href,
      email: contact.email,
      telephone: `+${contact.whatsappNumber}`,
      address: {
        '@type': 'PostalAddress',
        addressLocality: contact.office.city,
        addressRegion: contact.office.region,
        addressCountry: 'ID',
      },
      geo: { '@type': 'GeoCoordinates', latitude: contact.office.coords.lat, longitude: contact.office.coords.lng },
      sameAs: Object.values(contact.socials),
      founder: { '@type': 'Person', name: 'Fajrian Aidil Pratama', url: new URL('/founder/', Astro.site).href },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl,
      name: 'Banua Coder',
      inLanguage: ['id-ID', 'en-US'],
      publisher: { '@id': `${siteUrl}#organization` },
    },
  ],
}
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={shouldIndex ? 'index, follow' : 'noindex, nofollow'} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts load via the @fontsource imports in global.css (hashed by Vite); no manual preload. -->

    <!-- Theme color — deep blue works on light and dark OS chrome -->
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#F7F7F4" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0A0E14" />

    <!-- hreflang alternate links -->
    <link rel="alternate" hreflang="id" href={idUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={idUrl} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonical} />

    <!-- OG locale -->
    <meta property="og:locale" content={isEn ? 'en_US' : 'id_ID'} />
    <meta property="og:locale:alternate" content={isEn ? 'id_ID' : 'en_US'} />

    <!-- OpenGraph basics -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Banua Coder" />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogAbs} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {type === 'article' && (modifiedTime ?? publishedTime) && <meta property="article:modified_time" content={modifiedTime ?? publishedTime} />}
    {type === 'article' && <meta property="article:author" content="Fajrian Aidil Pratama" />}
    {type === 'article' && tags.map((t) => <meta property="article:tag" content={t} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@banuacoder" />
    <meta name="twitter:creator" content="@ryanaidilp_" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogAbs} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- View transitions — Astro built-in fade-slide between routes -->
    <ClientRouter fallback="animate" />

    <!-- Page-specific head content (meta, structured data, etc.) -->
    <slot name="head" />

    <!-- Header intro plays on a full load only; ClientRouter swaps skip it -->
    <script is:inline>
      document.addEventListener('astro:before-swap', function (e) { e.newDocument.documentElement.setAttribute('data-intro-skip', ''); });
    </script>

    <!-- FOUC prevention + view-transition persistence -->
    <script is:inline>
      (function () {
        function resolveTheme() {
          try {
            var stored = localStorage.getItem('theme');
            if (stored === 'dark') return 'dark';
            if (stored === 'light') return 'light';
            return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          } catch (e) {
            return 'light';
          }
        }
        function apply(root) {
          if (resolveTheme() === 'dark') root.classList.add('dark');
          else root.classList.remove('dark');
        }
        // Initial paint
        apply(document.documentElement);
        // View transitions: re-apply to the incoming document BEFORE swap so no flash
        document.addEventListener('astro:before-swap', function (e) {
          apply(e.newDocument.documentElement);
        });
      })();
    </script>
  </head>
  <body>
    <Fragment set:html={`<!-- THESIS: institutional prospectus for a studio that ships real systems; refuses rounded-card software-house default. OWN-WORLD: ultramarine #0B1FD0 plates alternate with chalk #F1F3F9 plates, hairline rules, zero radius, giant tonal numerals, folio labels, Geist display + Inter body. STORY: serious engineering studio in one viewport, real proof, book a call. FIRST VIEWPORT: ultramarine plate, huge headline, tonal 19 numeral, hairline stats strip. SIGNATURE: plate flips with numbered folios and masked line reveals. seed:973c84c7 -->`} />
    <slot />
  </body>

  <script>
    import { initAnimations } from '../lib/animations'

    let cleanup: (() => void) | null = null

    function boot() {
      cleanup?.()
      cleanup = initAnimations()
    }

    boot()

    // Re-init after Astro view transitions swap
    document.addEventListener('astro:after-swap', boot)
  </script>
</html>
