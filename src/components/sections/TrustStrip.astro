---
/**
 * TrustStrip: ruled row of claims on a chalk band. Small figures count up on entry.
 */
interface Claim {
  label: string
}

interface Props {
  claims: Claim[]
  class?: string
}

const { claims, class: cls = '' } = Astro.props

function parseClaim(label: string) {
  const parts: Array<{ text: string; value?: number }> = []
  const regex = /(\d+)/g
  let last = 0
  let m: RegExpExecArray | null
  while ((m = regex.exec(label)) !== null) {
    if (m.index > last) parts.push({ text: label.slice(last, m.index) })
    const v = parseInt(m[0], 10)
    // years are not counted up
    parts.push({ text: m[0], value: v < 1000 ? v : undefined })
    last = m.index + m[0].length
  }
  if (last < label.length) parts.push({ text: label.slice(last) })
  return parts
}
---

<section id="trust-strip" class:list={['plate-chalk', cls]} aria-label="Trust indicators">
  <div class="mx-auto px-4 sm:px-6 lg:px-8" style="max-width: var(--container-max)">
    <ul
      class="list-none m-0 p-0 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[repeat(var(--n),minmax(0,1fr))] border-b border-current/25"
      style={`--n: ${claims.length}`}
      role="list"
    >
      {claims.map((claim, i) => (
        <li class:list={['py-5 pr-4 text-[0.95rem] font-medium leading-snug', i > 0 && 'lg:pl-5 lg:border-l border-current/25', i > 0 && 'border-t sm:border-t-0 border-current/25 sm:pl-0']}>
          {parseClaim(claim.label).map((part) =>
            part.value !== undefined ? <span data-count-to={part.value}>{part.text}</span> : <span>{part.text}</span>,
          )}
        </li>
      ))}
    </ul>
  </div>
</section>
