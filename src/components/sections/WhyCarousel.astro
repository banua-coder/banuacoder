---
/**
 * WhyCarousel: differentiators as a hairline-ruled list with tonal numerals.
 * (Replaces the old pinned scroll carousel; the name is kept for backward compatibility.)
 */
import Plate from '../layout/Plate.astro'

interface WhyItem {
  title: string
  body: string
}

interface Props {
  eyebrow: string
  marker: string
  title: string
  subhead?: string
  items: WhyItem[]
  lang?: 'id' | 'en'
  tone?: 'plate' | 'chalk'
  /** Override the folio text; defaults to "№ NN / eyebrow" from marker */
  folio?: string
}

const { eyebrow, marker, title, items, tone = 'plate', folio } = Astro.props
const num = marker.match(/\d+/)?.[0]
const folioText = folio ?? `${num ? `№ ${num} / ` : ''}${eyebrow}`
---

<Plate tone={tone} folio={folioText} labelledby="why-carousel-heading" class="why-carousel">
  <div class="grid gap-12 lg:grid-cols-12">
    <h2 id="why-carousel-heading" class="display text-balance lg:col-span-5 lg:sticky lg:top-28 lg:self-start" style="font-size: var(--fs-64)">
      {title}
    </h2>
    <ol class="list-none m-0 p-0 lg:col-span-7 border-b border-current/25" role="list">
      {items.map((item, i) => (
        <li class="why-row grid grid-cols-[4rem_1fr] sm:grid-cols-[6rem_1fr] gap-x-4 border-t border-current/25 py-8">
          <span class="why-num display tabular-nums" style="font-size: var(--fs-48); line-height: 0.9" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <div>
            <h3 class="display" style="font-size: var(--fs-28); line-height: 1.05">{item.title}</h3>
            <p class="why-body mt-3 leading-relaxed" style="font-size: var(--fs-17); max-width: 50ch">{item.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</Plate>

<style>
  .why-num { color: color-mix(in srgb, currentColor 38%, transparent); }
  .why-body { color: color-mix(in srgb, currentColor 76%, transparent); }
</style>
