---
/**
 * DotGridBackdrop: kept for API compatibility. Now a strict 12-column hairline grid
 * (no dots). Parallax is still wired through [data-dot-grid] in animations.ts.
 */
interface Props {
  class?: string
}

const { class: cls = '' } = Astro.props
---

<div id="dot-grid-backdrop" class:list={['dot-grid-backdrop', cls]} data-dot-grid aria-hidden="true"></div>

<style>
  .dot-grid-backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background-image: repeating-linear-gradient(to right, currentColor 0 1px, transparent 1px calc(100% / 12));
    opacity: 0.08;
  }
</style>
