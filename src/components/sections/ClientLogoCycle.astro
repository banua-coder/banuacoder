---
/**
 * ClientLogoCycle: clients and partners as a hairline-ruled grid on a chalk plate.
 * (Replaces the old pinned scroll-driven cycle; the name is kept for backward compatibility.)
 * Logos render greyscale and return to colour on hover; in dark mode brand marks turn white,
 * state emblems (pemprov-* / pemkab-*) keep their heraldry.
 */
import Plate from '../layout/Plate.astro'
import { clients } from '../../data/clients'

const logoModules = import.meta.glob('/src/assets/clients/*.{svg,png}', {
  eager: true,
  query: '?url',
  import: 'default',
}) as Record<string, string>

const logoUrls: Record<string, string> = Object.fromEntries(
  Object.entries(logoModules).map(([path, url]) => [path.split('/').pop() ?? '', url]),
)

interface Props {
  lang?: 'id' | 'en'
  folio?: string
}

const { lang = 'id', folio } = Astro.props

const heading = lang === 'en' ? 'Our clients and partners' : 'Klien dan partner kami'
const subhead =
  lang === 'en'
    ? 'From public sector to international consumer products.'
    : 'Dari sektor publik hingga produk consumer internasional.'
const defaultFolio = `№ 01 / ${lang === 'en' ? 'Trusted by' : 'Dipercaya oleh'}`
const list = clients.filter((c) => logoUrls[c.logo])
---

<Plate tone="chalk" folio={folio ?? defaultFolio} labelledby="clients-heading" class="client-cycle">
  <div class="grid gap-8 lg:grid-cols-12 lg:items-end mb-12 lg:mb-16">
    <h2 id="clients-heading" class="display text-balance lg:col-span-7" style="font-size: var(--fs-64)">{heading}</h2>
    <p class="cc-sub lg:col-span-5 leading-relaxed" style="font-size: var(--fs-20); max-width: 40ch">{subhead}</p>
  </div>

  <ul class="cc-grid list-none m-0 p-0 grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5" role="list">
    {list.map((client) => (
      <li class="cc-cell flex flex-col items-center justify-center gap-4 px-4 py-8">
        <img
          src={logoUrls[client.logo]}
          alt={client.name}
          loading="lazy"
          decoding="async"
          class="cc-logo h-14 sm:h-16 w-auto max-w-[9rem] object-contain"
          data-pemda={client.logo.startsWith('pemprov-') || client.logo.startsWith('pemkab-') ? '' : undefined}
        />
        <span class="cc-name folio text-center" style="letter-spacing: 0.08em">{client.name}</span>
      </li>
    ))}
  </ul>
</Plate>

<style>
  .cc-sub { color: color-mix(in srgb, currentColor 74%, transparent); }
  .cc-grid { border-top: 1px solid color-mix(in srgb, currentColor 28%, transparent); border-left: 1px solid color-mix(in srgb, currentColor 28%, transparent); }
  .cc-cell { border-right: 1px solid color-mix(in srgb, currentColor 28%, transparent); border-bottom: 1px solid color-mix(in srgb, currentColor 28%, transparent); }
  .cc-name { color: var(--color-bnc-stone-600); }
  .cc-logo { filter: grayscale(1) contrast(1.05); transition: filter 250ms; }
  .cc-cell:hover .cc-logo { filter: none; }
  :global(html.dark) .cc-name { color: var(--color-bnc-stone-400); }
  :global(html.dark) .cc-logo:not([data-pemda]) { filter: brightness(0) invert(1); }
  :global(html.dark) .cc-cell:hover .cc-logo:not([data-pemda]) { filter: brightness(0) invert(1); }
  :global(html.dark) .cc-logo[data-pemda] { filter: grayscale(1) brightness(1.15); }
  :global(html.dark) .cc-cell:hover .cc-logo[data-pemda] { filter: none; }
</style>
