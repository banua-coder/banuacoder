---
/**
 * CTA: closing plate. Always a full ultramarine plate with a white primary button.
 * `inverted` is accepted for backward compatibility and ignored (the CTA is always the plate).
 * Booking + WhatsApp are always shown; primaryCta/secondaryCta render as underlined links.
 */
import Container from '../layout/Container.astro'
import Button from '../atoms/Button.astro'
import { contact, bookingLabel, buildServiceWhatsAppUrl, buildWhatsAppUrl } from '../../data/contact'

interface Props {
  headline: string
  sub?: string
  primaryCta?: string
  primaryHref?: string
  secondaryCta?: string
  secondaryHref?: string
  /** Ignored: the CTA is always an ultramarine plate (kept for old callers) */
  inverted?: boolean
  service?: string
  class?: string
}

const {
  headline,
  sub,
  primaryCta,
  primaryHref = '#',
  secondaryCta,
  secondaryHref = '#',
  service,
  class: cls = '',
} = Astro.props

const loc = (Astro.currentLocale ?? 'id') as 'id' | 'en'
const waUrl = service ? buildServiceWhatsAppUrl(loc, service) : buildWhatsAppUrl(loc)
const waLabel = loc === 'en' ? 'Chat on WhatsApp' : 'Chat WhatsApp'
---

<section
  class:list={['plate relative overflow-hidden', cls]}
  style="padding-block: var(--spacing-section-y)"
  aria-label="Call to action"
  data-tell-cta
>
  <span class="cta-arrow numeral absolute z-0" aria-hidden="true" data-parallax="0.1">→</span>
  <Container class="relative z-10">
    <p class="folio mute border-b border-[var(--color-bnc-plate-line)] pb-3 mb-10 lg:mb-16">
      {loc === 'en' ? 'Start a project' : 'Mulai proyek'}
    </p>
    <h2
      class="display text-balance max-w-[18ch]"
      style="font-size: var(--fs-64)"
      data-split
      data-tell-cta-headline
    >
      {headline}
    </h2>

    {sub && (
      <p class="mute mt-8 leading-relaxed" style="font-size: var(--fs-20); max-width: 52ch" data-tell-cta-sub>
        {sub}
      </p>
    )}

    <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4" data-tell-cta-actions>
      <Button href={contact.bookingUrl} external size="lg" variant="primary">{bookingLabel[loc]}</Button>
      <Button href={waUrl} external size="lg" variant="secondary">{waLabel}</Button>
      {primaryCta && <Button href={primaryHref} size="lg" variant="ghost">{primaryCta} →</Button>}
      {secondaryCta && <Button href={secondaryHref} size="lg" variant="ghost">{secondaryCta} →</Button>}
    </div>
  </Container>
</section>

<style>
  .cta-arrow { right: 2vw; bottom: -0.1em; font-size: clamp(10rem, 4rem + 26vw, 28rem); line-height: 1; }
</style>
