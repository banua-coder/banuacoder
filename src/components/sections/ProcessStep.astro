---
/**
 * ProcessStep: a ruled row with a tonal numeral. Colour comes from the surrounding plate.
 */
interface Props {
  step: number
  title: string
  body?: string
  /** kept for backward compatibility; rows are ruled, so there is no connector */
  last?: boolean
  class?: string
}

const { step, title, body, class: cls = '' } = Astro.props
const n = String(step).padStart(2, '0')
---

<div class:list={['ps grid grid-cols-[4.5rem_1fr] sm:grid-cols-[6.5rem_1fr] gap-x-4 border-t border-current/25 py-7', cls]}>
  <span class="ps-num display tabular-nums" style="font-size: var(--fs-48); line-height: 0.9" aria-hidden="true">{n}</span>
  <div>
    <h3 data-split class="display" style="font-size: var(--fs-28); line-height: 1.05">{title}</h3>
    {body && (
      <p class="ps-body mt-3 leading-relaxed" style="font-size: var(--fs-17); max-width: 46ch">{body}</p>
    )}
    <slot />
  </div>
</div>

<style>
  .ps-num { color: color-mix(in srgb, currentColor 38%, transparent); }
  .ps-body { color: color-mix(in srgb, currentColor 76%, transparent); }
</style>
