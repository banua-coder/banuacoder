---
/**
 * Footer: running footer on a chalk plate (navy ink in dark mode). 12-col, hairline rules.
 */
import Logo from '../brand/Logo.astro'
import { contact, bookingLabel, bookingShortLabel } from '../../data/contact'

const locale = Astro.currentLocale ?? 'id'
const isEn = locale === 'en'
const prefix = isEn ? '/en' : ''
const year = new Date().getFullYear()

const siteLinks = isEn
  ? [
      { href: `${prefix}/services/`, label: 'Services' },
      { href: `${prefix}/portfolio/`, label: 'Portfolio' },
      { href: `${prefix}/about/`, label: 'About' },
      { href: `${prefix}/founder/`, label: 'Founder' },
      { href: `${prefix}/blog/`, label: 'Blog' },
      { href: `${prefix}/contact/`, label: 'Contact' },
    ]
  : [
      { href: `${prefix}/services/`, label: 'Layanan' },
      { href: `${prefix}/portfolio/`, label: 'Portfolio' },
      { href: `${prefix}/about/`, label: 'Tentang' },
      { href: `${prefix}/founder/`, label: 'Founder' },
      { href: `${prefix}/blog/`, label: 'Blog' },
      { href: `${prefix}/contact/`, label: 'Kontak' },
    ]

const socials = [
  { href: contact.socials.linkedin, label: 'LinkedIn' },
  { href: contact.socials.github, label: 'GitHub' },
  { href: contact.socials.instagram, label: 'Instagram' },
  { href: contact.socials.medium, label: 'Medium' },
  { href: contact.socials.youtube, label: 'YouTube' },
]
---

<footer class="plate-chalk mt-auto border-t border-bnc-ink/25 dark:border-bnc-paper/25" aria-label="Site footer">
  <div class="mx-auto px-4 sm:px-6 lg:px-8 pt-14 lg:pt-20 pb-8" style="max-width: var(--container-max)">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-8">
      <div class="md:col-span-5 flex flex-col gap-6">
        <Logo variant="lockup" width={30} />
        <p class="display text-balance" style="font-size: var(--fs-28); max-width: 20ch">
          {isEn ? 'Digital systems built to last.' : 'Sistem digital yang dibangun untuk bertahan.'}
        </p>
        <a
          href={contact.bookingUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex w-fit items-center gap-2 bg-bnc-plate px-5 py-3 text-sm font-semibold text-white hover:bg-bnc-ink dark:bg-bnc-accent dark:text-bnc-ink dark:hover:bg-white transition-colors"
        >
          {bookingLabel[locale as 'id' | 'en']} <span aria-hidden="true">→</span>
        </a>
      </div>

      <nav aria-label="Footer site map" class="md:col-span-3 md:col-start-7">
        <p class="folio ft-mute border-b border-current/25 pb-3 mb-4">{isEn ? 'Index' : 'Indeks'}</p>
        <ul class="list-none m-0 p-0 flex flex-col" role="list">
          {siteLinks.map((link) => (
            <li>
              <a href={link.href} class="ft-link block py-1.5 text-base font-medium">{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="md:col-span-3">
        <p class="folio ft-mute border-b border-current/25 pb-3 mb-4">{isEn ? 'Elsewhere' : 'Di tempat lain'}</p>
        <ul class="list-none m-0 p-0 flex flex-col" role="list">
          {socials.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer" class="ft-link block py-1.5 text-base font-medium">
                {s.label} <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-14 pt-5 border-t border-current/25 flex flex-col md:flex-row md:items-center md:justify-between gap-5">
      <p class="folio ft-mute">
        &copy; {year} PT Banua Coder Indonesia / {contact.office.city}, {contact.office.region}
      </p>
      <a
        href="https://pse.komdigi.go.id/pse"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 self-start border border-current/25 px-3 py-2 hover:border-bnc-plate dark:hover:border-bnc-accent transition-colors"
        aria-label="Terdaftar di PSE Komdigi"
      >
        <img src="/badges/komdigi.png" alt="Komdigi" width={32} height={32} loading="lazy" decoding="async" class="h-7 w-auto object-contain" />
        <span class="flex flex-col leading-tight">
          <span class="folio ft-mute" style="font-size: 10px">{isEn ? 'Registered with' : 'Terdaftar di'}</span>
          <span class="font-mono text-xs">PSE Komdigi · 015494.01/DJAI.PSE/09/2024</span>
        </span>
      </a>
    </div>
  </div>
</footer>

<style>
  .ft-mute { color: var(--color-bnc-stone-600); }
  :global(html.dark) .ft-mute { color: var(--color-bnc-stone-400); }
  .ft-link { text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 5px; transition: text-decoration-color 180ms; }
  .ft-link:hover, .ft-link:focus-visible { text-decoration-color: currentColor; }
</style>
