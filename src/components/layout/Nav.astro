---
/**
 * Nav: hairline running header. Wordmark left, links centre, 'Jadwalkan panggilan →' right.
 * Solid chalk (navy ink in dark mode) so it reads over plates and chalk alike.
 */
import Logo from '../brand/Logo.astro'
import LangSwitcher from '../interactive/LangSwitcher.astro'
import ThemeToggle from '../interactive/ThemeToggle.astro'
import MobileDrawer from './MobileDrawer.astro'
import { contact, bookingLabel, bookingShortLabel } from '../../data/contact'

const locale = Astro.currentLocale ?? 'id'
const isEn = locale === 'en'
const prefix = isEn ? '/en' : ''

const navLinks = isEn
  ? [
      { href: `${prefix}/services/`, label: 'Services' },
      { href: `${prefix}/portfolio/`, label: 'Portfolio' },
      { href: `${prefix}/about/`, label: 'About' },
      { href: `${prefix}/blog/`, label: 'Blog' },
      { href: `${prefix}/estimate/`, label: 'Estimate' },
      { href: `${prefix}/contact/`, label: 'Contact' },
    ]
  : [
      { href: `${prefix}/services/`, label: 'Layanan' },
      { href: `${prefix}/portfolio/`, label: 'Portfolio' },
      { href: `${prefix}/about/`, label: 'Tentang' },
      { href: `${prefix}/blog/`, label: 'Blog' },
      { href: `${prefix}/estimate/`, label: 'Estimasi' },
      { href: `${prefix}/contact/`, label: 'Kontak' },
    ]
---

<header
  id="site-nav"
  class="fixed top-0 left-0 right-0 z-50 transition-transform duration-300 bg-bnc-paper dark:bg-bnc-ink border-b border-bnc-ink/25 dark:border-bnc-paper/25 will-change-transform"
  data-nav-scroll
>
  <nav
    aria-label="Site navigation"
    class="mx-auto flex items-center justify-between gap-4 px-4 sm:px-6 lg:px-8 h-16"
    style="max-width: var(--container-max)"
  >
    <a href={isEn ? '/en/' : '/'} class="flex items-center shrink-0" aria-label="Banua Coder home">
      <Logo variant="lockup" width={26} />
    </a>

    <ul class="hidden md:flex items-center gap-5 lg:gap-7 list-none m-0 p-0" role="list">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="nav-link text-sm font-medium text-bnc-ink dark:text-bnc-paper"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-1.5 sm:gap-3">
      <a
        href={contact.bookingUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden lg:inline-flex items-center gap-1.5 text-sm font-semibold text-bnc-plate dark:text-bnc-accent underline underline-offset-[6px] decoration-1 hover:decoration-2 mr-2"
      >
        {bookingShortLabel[locale as 'id' | 'en']} <span aria-hidden="true">→</span>
      </a>
      <LangSwitcher />
      <ThemeToggle />

      <button
        id="nav-hamburger"
        type="button"
        class="md:hidden flex flex-col justify-center items-center w-10 h-10 gap-1.5 hover:bg-bnc-ink/5 dark:hover:bg-bnc-paper/10"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        <span class="block w-5 h-px bg-bnc-ink dark:bg-bnc-paper"></span>
        <span class="block w-5 h-px bg-bnc-ink dark:bg-bnc-paper"></span>
        <span class="block w-5 h-px bg-bnc-ink dark:bg-bnc-paper"></span>
      </button>
    </div>
  </nav>
</header>

<MobileDrawer />

<style>
  .nav-link { background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat; padding-bottom: 3px; transition: background-size 250ms; }
  .nav-link:hover, .nav-link:focus-visible { background-size: 100% 1px; }
  [data-nav-scroll].is-hidden { transform: translateY(-100%); }
  @media (prefers-reduced-motion: reduce) {
    [data-nav-scroll], .nav-link { transition: none; }
  }
</style>
