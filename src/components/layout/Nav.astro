---
/**
 * Nav: hairline running header. Wordmark left, links centre, 'Jadwalkan panggilan →' right.
 * Solid chalk (navy ink in dark mode) so it reads over plates and chalk alike.
 */
import Logo from '../brand/Logo.astro'
import LangSwitcher from '../interactive/LangSwitcher.astro'
import ThemeToggle from '../interactive/ThemeToggle.astro'
import MobileDrawer from './MobileDrawer.astro'
import { contact, bookingLabel, bookingShortLabel } from '../../data/contact'

const locale = Astro.currentLocale ?? 'id'
const isEn = locale === 'en'
const prefix = isEn ? '/en' : ''

const navLinks = isEn
  ? [
      { href: `${prefix}/services/`, label: 'Services' },
      { href: `${prefix}/portfolio/`, label: 'Portfolio' },
      { href: `${prefix}/about/`, label: 'About' },
      { href: `${prefix}/blog/`, label: 'Blog' },
      { href: `${prefix}/estimate/`, label: 'Estimate' },
      { href: `${prefix}/contact/`, label: 'Contact' },
    ]
  : [
      { href: `${prefix}/services/`, label: 'Layanan' },
      { href: `${prefix}/portfolio/`, label: 'Portfolio' },
      { href: `${prefix}/about/`, label: 'Tentang' },
      { href: `${prefix}/blog/`, label: 'Blog' },
      { href: `${prefix}/estimate/`, label: 'Estimasi' },
      { href: `${prefix}/contact/`, label: 'Kontak' },
    ]
---

<header
  id="site-nav"
  class="nav-shell fixed top-0 left-0 right-0 z-50 border-b will-change-transform"
  data-nav-scroll
  data-tone="chalk"
>
  <nav
    aria-label="Site navigation"
    class="mx-auto flex items-center justify-between gap-4 px-4 sm:px-6 lg:px-8 h-16"
    style="max-width: var(--container-max)"
  >
    <a href={isEn ? '/en/' : '/'} class="nav-intro-item flex items-center shrink-0" style="--nd:40ms" aria-label="Banua Coder home">
      <span class="logo-chalk"><Logo variant="lockup" width={26} /></span>
      <span class="logo-plate"><Logo variant="lockup" width={26} tone="plate" /></span>
    </a>

    <ul class="hidden md:flex items-center gap-5 lg:gap-7 list-none m-0 p-0" role="list">
      {navLinks.map((link, i) => (
        <li class="nav-intro-mask" style={`--ni:${i}`}>
          <a
            href={link.href}
            class="nav-link interactive-hover text-sm font-medium text-bnc-ink dark:text-bnc-paper"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="nav-intro-item flex items-center gap-1.5 sm:gap-3" style="--nd:160ms">
      <a
        href={contact.bookingUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="nav-book hidden lg:inline-flex items-center gap-1.5 text-sm font-semibold text-bnc-plate dark:text-bnc-accent underline underline-offset-[6px] decoration-1 hover:decoration-2 mr-2"
      >
        {bookingShortLabel[locale as 'id' | 'en']} <span aria-hidden="true">→</span>
      </a>
      <LangSwitcher />
      <ThemeToggle />

      <button
        id="nav-hamburger"
        type="button"
        class="md:hidden flex flex-col justify-center items-center w-10 h-10 gap-1.5 hover:bg-bnc-ink/5 dark:hover:bg-bnc-paper/10"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        <span class="block w-5 h-px bg-bnc-ink dark:bg-bnc-paper"></span>
        <span class="block w-5 h-px bg-bnc-ink dark:bg-bnc-paper"></span>
        <span class="block w-5 h-px bg-bnc-ink dark:bg-bnc-paper"></span>
      </button>
    </div>
  </nav>
</header>

<MobileDrawer />

<style>
  /* The bar takes the colour of the plate underneath it, so it never floats as a white strip over a blue hero. */
  .nav-shell { transition: transform 300ms, background-color 300ms var(--motion-ease-out), border-color 300ms var(--motion-ease-out), color 300ms var(--motion-ease-out); }
  .nav-shell[data-tone='chalk'] { background: var(--color-bnc-paper); border-color: rgb(6 11 46 / 0.25); }
  :global(html.dark) .nav-shell[data-tone='chalk'] { background: var(--color-bnc-ink); border-color: rgb(241 243 249 / 0.25); }
  .nav-shell[data-tone='plate'] { background: var(--color-bnc-plate); border-color: var(--color-bnc-plate-line); color: #fff; }
  .nav-shell[data-tone='plate'] :global(a), .nav-shell[data-tone='plate'] :global(button), .nav-shell[data-tone='plate'] :global(span), .nav-shell[data-tone='plate'] :global(svg) { color: #fff; }
  .nav-shell[data-tone='plate'] :global(.nav-book) { text-decoration-color: var(--color-bnc-accent); }
  .nav-shell[data-tone='plate'] :global(a[hreflang]) { border-color: rgb(255 255 255 / 0.4); }
  .nav-shell[data-tone='plate'] :global(#nav-hamburger span) { background: #fff; }
  .nav-shell[data-tone='plate'] :global(#theme-toggle:hover), .nav-shell[data-tone='plate'] :global(#nav-hamburger:hover) { background: rgb(255 255 255 / 0.12); }
  .logo-plate { display: none; }
  .nav-shell[data-tone='plate'] :global(.logo-plate) { display: inline-flex; }
  .nav-shell[data-tone='plate'] :global(.logo-chalk) { display: none; }
  [data-nav-scroll].is-hidden { transform: translateY(-100%); }
  @media (prefers-reduced-motion: reduce) { .nav-shell { transition: none; } }
</style>

<script>
  // Tone follows the plate under the bar (ultramarine plate -> blue bar, chalk plate -> paper/ink bar).
  function bindNavTone() {
    const nav = document.getElementById('site-nav')
    if (!nav) return
    let raf = 0
    const sample = () => {
      raf = 0
      const y = nav.getBoundingClientRect().bottom - 2
      const x = Math.min(window.innerWidth - 2, Math.max(2, window.innerWidth / 2))
      const els = document.elementsFromPoint(x, Math.max(1, y))
      const plate = els.find((e) => !nav.contains(e) && e.closest('.plate, .plate-chalk'))
      const tone = plate?.closest('.plate') ? 'plate' : 'chalk'
      if (nav.dataset.tone !== tone) nav.dataset.tone = tone
    }
    const queue = () => { if (!raf) raf = requestAnimationFrame(sample) }
    sample()
    window.addEventListener('scroll', queue, { passive: true })
    window.addEventListener('resize', queue, { passive: true })
    document.addEventListener('astro:before-swap', () => { window.removeEventListener('scroll', queue); window.removeEventListener('resize', queue) }, { once: true })
  }
  bindNavTone()
  document.addEventListener('astro:after-swap', bindNavTone)
</script>
