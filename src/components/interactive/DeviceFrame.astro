---
/**
 * DeviceFrame — sharp, flat plate frame for a real screenshot (Prospectus language).
 * phone / tablet: ink mat with a 1px hairline. desktop: chalk bar with the address as plain mono text.
 * No radius, no shadow, no tilt. Give the slotted <img> meaningful alt text.
 * blurred — blur + grayscale slot content (NDA redaction).
 * `static` is accepted for backwards compatibility and ignored (there is no motion).
 */
interface Props {
  variant?: 'phone' | 'tablet' | 'desktop' | 'terminal'
  blurred?: boolean
  /** Text shown in the browser address bar (desktop only) */
  url?: string
  static?: boolean
  class?: string
}

const { variant = 'phone', blurred = false, url = '', class: cls = '' } = Astro.props
---

<div class:list={['device-frame', `device-${variant}`, cls]}>
  {(variant === 'desktop' || variant === 'terminal') && (
    <div class="device-chrome" aria-hidden="true">
      <span class="device-url">{url || (variant === 'terminal' ? 'zsh' : 'banuacoder.com')}</span>
    </div>
  )}
  <div class:list={['device-screen', blurred && 'device-blurred']}>
    <slot />
  </div>
</div>

<style>
  .device-frame {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    background: var(--color-bnc-ink);
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 0;
    box-shadow: none;
  }
  .device-screen {
    position: relative;
    overflow: hidden;
    background: var(--color-bnc-stone-100);
  }
  :global(html.dark) .device-screen { background: var(--color-bnc-stone-800); }
  .device-screen :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .device-blurred { filter: blur(8px) grayscale(1); }

  .device-phone { max-width: 260px; padding: 6px; }
  .device-phone .device-screen { aspect-ratio: 9 / 19.5; }

  .device-tablet { max-width: 420px; padding: 8px; }
  .device-tablet .device-screen { aspect-ratio: 4 / 3; }

  .device-desktop { max-width: 880px; background: var(--color-bnc-paper); border-color: var(--color-bnc-ink); }
  :global(html.dark) .device-desktop { background: var(--color-bnc-ink); border-color: rgba(255, 255, 255, 0.35); }
  .device-desktop .device-screen { aspect-ratio: 16 / 10; }
  .device-terminal { max-width: 880px; background: #0A0F2C; border-color: rgba(255, 255, 255, 0.35); }
  .device-terminal .device-screen { aspect-ratio: 16 / 10; background: #0A0F2C; }
  .device-terminal .device-chrome { border-color: rgba(255, 255, 255, 0.25); color: #8C96C8; }
  .device-chrome {
    padding: 8px 12px;
    border-bottom: 1px solid var(--color-bnc-ink);
    color: var(--color-bnc-stone-600);
  }
  :global(html.dark) .device-chrome { border-color: rgba(255, 255, 255, 0.35); color: var(--color-bnc-stone-300); }
  .device-url {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font: 11px/1 var(--font-mono, monospace);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
