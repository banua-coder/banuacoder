---
/**
 * ServiceCard — one numbered row of the services contents page.
 * Ruled, flat, no icon tile. Whole row is the link (stretched). Hover/focus flips the row to the opposite plate.
 * tone="chalk" sits on a chalk plate (flips to ultramarine); tone="plate" sits on ultramarine (flips to white).
 * `icon` is accepted for backwards compatibility and ignored.
 */
interface Props {
  title: string
  tagline: string
  icon?: string
  deliverables?: string[]
  href?: string
  /** 1-based position in the contents; rendered as 01, 02 ... */
  index?: number
  tone?: 'chalk' | 'plate'
  class?: string
}

const { title, tagline, deliverables = [], href = '#', index, tone = 'chalk', class: cls = '' } = Astro.props
const en = (Astro.currentLocale ?? 'id') === 'en'
const num = index ? String(index).padStart(2, '0') : ''
const bullets = deliverables.slice(0, 3)
const onPlate = tone === 'plate'
---

<article
  class:list={[
    'svc-row group relative border-t transition-colors duration-[var(--duration-base)]',
    onPlate
      ? 'border-white/25 hover:bg-white hover:text-bnc-plate focus-within:bg-white focus-within:text-bnc-plate'
      : 'border-bnc-ink/80 dark:border-bnc-paper/40 hover:bg-bnc-plate hover:text-white focus-within:bg-bnc-plate focus-within:text-white',
    cls,
  ]}
>
  <div class="grid grid-cols-12 gap-x-4 lg:gap-x-6 lg:px-4 py-6 lg:py-8 items-start">
    <p
      class:list={[
        'display col-span-3 lg:col-span-2 tabular-nums transition-colors',
        onPlate ? 'text-bnc-plate-lift group-hover:text-bnc-stone-200 group-focus-within:text-bnc-stone-200' : 'text-bnc-stone-300 dark:text-bnc-stone-700 group-hover:text-bnc-plate-lift group-focus-within:text-bnc-plate-lift',
      ]}
      style="font-size: var(--fs-64); line-height: 0.85"
      aria-hidden="true"
    >{num}</p>

    <div class="col-span-9 lg:col-span-5 flex flex-col gap-3">
      <h3 class="display" style="font-size: var(--fs-36); line-height: 1.02">
        <a
          href={href}
          class:list={[
            "after:absolute after:inset-0 after:content-[''] focus-visible:outline-2 focus-visible:outline-offset-4",
            onPlate ? 'focus-visible:outline-bnc-ink' : 'focus-visible:outline-bnc-accent',
          ]}
        >{title}</a>
      </h3>
      <p
        class:list={[
          'leading-relaxed max-w-[52ch]',
          onPlate ? 'text-bnc-plate-mute group-hover:text-bnc-plate group-focus-within:text-bnc-plate' : 'text-bnc-stone-600 dark:text-bnc-stone-400 group-hover:text-bnc-plate-mute group-focus-within:text-bnc-plate-mute',
        ]}
        style="font-size: var(--fs-17)"
      >{tagline}</p>
    </div>

    <ul
      class:list={[
        'col-span-9 col-start-4 lg:col-span-4 lg:col-start-9 max-lg:mt-4 flex flex-col',
        onPlate ? 'text-bnc-plate-mute group-hover:text-bnc-plate group-focus-within:text-bnc-plate' : 'text-bnc-stone-600 dark:text-bnc-stone-400 group-hover:text-bnc-plate-mute group-focus-within:text-bnc-plate-mute',
      ]}
      style="font-size: var(--fs-14)"
    >
      {bullets.map((item) => (
        <li class="py-1.5 border-b border-current/20 first:border-t">{item}</li>
      ))}
      <li class="folio pt-3 text-current">{en ? 'Read more' : 'Selengkapnya'} →</li>
    </ul>
  </div>
</article>
