---
/**
 * Card: a flat ruled panel. No radius, no shadow; a hairline frame and a quiet hover rule.
 */
interface Props {
  class?: string
  noHover?: boolean
  padding?: 'none' | 'sm' | 'md' | 'lg'
}

const { class: cls = '', noHover = false, padding = 'md' } = Astro.props

const paddingClass = { none: '', sm: 'p-4', md: 'p-6', lg: 'p-8' }[padding]
---

<div
  class:list={[
    'border border-bnc-ink/20 dark:border-bnc-paper/20',
    paddingClass,
    !noHover && 'transition-colors duration-[var(--duration-base)] hover:border-bnc-plate dark:hover:border-bnc-accent',
    cls,
  ]}
>
  <slot />
</div>
