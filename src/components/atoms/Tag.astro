---
/**
 * Tag: hairline mono label for bucket tags and tech stack labels. Square, no fill.
 * Variants keep their names; public-sector gets a solid plate fill, open-source a dashed hairline.
 */
interface Props {
  variant?: 'default' | 'bucket-consumer' | 'bucket-public' | 'bucket-operational' | 'bucket-open-source'
  class?: string
}

const { variant = 'default', class: cls = '' } = Astro.props

const variantClass = {
  default: 'border border-current/30 text-bnc-stone-600 dark:text-bnc-stone-400',
  'bucket-consumer': 'border border-bnc-ink/50 dark:border-bnc-paper/50 text-bnc-ink dark:text-bnc-paper',
  'bucket-public': 'border border-bnc-plate bg-bnc-plate text-white',
  'bucket-operational': 'border border-bnc-stone-500 text-bnc-stone-700 dark:text-bnc-stone-300',
  'bucket-open-source': 'border border-dashed border-bnc-stone-500 text-bnc-stone-600 dark:text-bnc-stone-400',
}[variant]
---

<span
  class:list={['inline-flex items-center px-2 py-0.5 font-mono text-xs uppercase tracking-wider', variantClass, cls]}
>
  <slot />
</span>
