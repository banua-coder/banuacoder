---
/**
 * SectionHeader: folio line ("№ 02 / Layanan") on a hairline, then a large display heading.
 * Inherits text colour from its plate (works on ultramarine and chalk).
 * `marker` like "[ 03 ]" is converted to "№ 03".
 */
interface Props {
  eyebrow?: string
  marker?: string
  title: string
  description?: string
  align?: 'left' | 'center'
  class?: string
  /** Heading id for aria-labelledby */
  id?: string
}

const { eyebrow, marker, title, description, align = 'left', class: cls = '', id } = Astro.props

const num = marker?.match(/\d+/)?.[0]
const folio = [num ? `№ ${num}` : '', eyebrow ?? ''].filter(Boolean).join(' / ')
const center = align === 'center'
---

<div class:list={['sh flex flex-col gap-5', center ? 'text-center items-center' : 'items-start', cls]}>
  {folio && <p class="sh-folio folio">{folio}</p>}
  <h2 id={id} class="display text-balance" style="font-size: var(--fs-48)">{title}</h2>
  {description && (
    <p class="sh-desc leading-relaxed" style="font-size: var(--fs-20); max-width: var(--prose-max)">{description}</p>
  )}
</div>

<style>
  .sh-folio { color: var(--color-bnc-stone-600); }
  .sh-desc { color: color-mix(in srgb, currentColor 74%, transparent); }
  :global(html.dark) .sh-folio { color: var(--color-bnc-stone-400); }
  :global(.plate) .sh-folio { color: var(--color-bnc-plate-mute); }
</style>
