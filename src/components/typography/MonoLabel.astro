---
/**
 * MonoLabel: folio-style label (mono, tracked, uppercase). Prefix is optional and empty by default.
 */
interface Props {
  prefix?: '//' | '>' | ''
  class?: string
}

const { prefix = '', class: cls = '' } = Astro.props
---

<span class:list={['folio text-bnc-stone-600 dark:text-bnc-stone-400', cls]}>
  {prefix && <span aria-hidden="true">{prefix}&nbsp;</span>}<slot />
</span>
