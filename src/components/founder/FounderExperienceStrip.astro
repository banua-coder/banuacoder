---
/**
 * FounderExperienceStrip — horizontal logo row with hover tooltips showing context.
 * Imports from src/data/founder-experience.ts.
 * Renders <img> when a real logo asset is available in src/assets/companies/,
 * otherwise falls back to a mono uppercase wordmark.
 * Keyboard accessible: focus also reveals tooltip.
 */
import { founderExperience } from '../../data/founder-experience'

const logoModules = import.meta.glob('/src/assets/companies/*.{svg,png}', {
  eager: true,
  query: '?url',
  import: 'default',
}) as Record<string, string>

const logoUrls: Record<string, string> = Object.fromEntries(
  Object.entries(logoModules).map(([path, url]) => [
    path.split('/').pop() ?? '',
    url,
  ]),
)
---

<div class="flex flex-wrap gap-6 items-center" role="list" aria-label="Founder experience at companies">
  {founderExperience.map((exp) => (
    <div
      class="experience-item relative inline-flex"
      role="listitem"
    >
      <button
        type="button"
        class="flex items-center justify-center px-4 py-2 border border-current/25 hover:border-bnc-plate dark:hover:border-bnc-accent transition-colors group"
        aria-describedby={`exp-tip-${exp.company.replace(/\W+/g, '-')}`}
        aria-label={`${exp.company}: ${exp.context}`}
      >
        {logoUrls[exp.logo] ? (
          <img
            src={logoUrls[exp.logo]}
            alt={exp.company}
            loading="lazy"
            decoding="async"
            class="h-8 w-auto max-w-[120px] object-contain grayscale opacity-70 dark:brightness-0 dark:invert group-hover:grayscale-0 group-hover:opacity-100 transition-[filter,opacity] duration-[var(--duration-base)]"
          />
        ) : (
          <span class="font-mono text-xs font-medium text-bnc-stone-600 dark:text-bnc-stone-400 group-hover:text-bnc-ink dark:group-hover:text-bnc-paper transition-colors whitespace-nowrap tracking-wide uppercase">
            {exp.company}
          </span>
        )}
      </button>

      <!-- Tooltip -->
      <span
        id={`exp-tip-${exp.company.replace(/\W+/g, '-')}`}
        role="tooltip"
        class="exp-tooltip absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-3 py-1.5 bg-bnc-ink text-bnc-paper border border-bnc-paper/30 font-mono text-xs whitespace-nowrap pointer-events-none opacity-0 translate-y-1 transition-all duration-[var(--duration-quick)] z-20"
      >
        {exp.context}
      </span>
    </div>
  ))}
</div>

<style>
  .experience-item:hover .exp-tooltip,
  .experience-item button:focus-visible ~ .exp-tooltip {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
</style>
