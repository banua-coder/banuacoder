---
/**
 * Port of cektrans mobile map view (apps/web: TopBar.vue + MapView/MapLegend.vue + MobileRoutesPanel.vue + BottomSheet.vue).
 * Source: ~/Documents/Projects/Web/trans_sulteng_tracker; checked against https://cektrans.banuacoder.com/palu at 390px.
 * Tokens (src/styles/global.css): paper #F7F7F4, primary #12398C, accent #1D9CD4, stone-100 #F5F5F4, stone-200 #E7E5E4,
 *   stone-500 #6E6863, stone-600 #57534E; fonts Inter / JetBrains Mono.
 * Measured on the live capture: sea #C2C8CA, land #F2F3F0, K1 #D60000, K2C #FFC800, K4C #7D4305.
 * Layout (css px, stage 390 wide): header 56, clock strip to 88, map fills to the sheet, sheet peek 88 (tabs 28 high, pill).
 * Corridor lines/coast are a hand trace of the live map (approximate); the clock/bus count are example values.
 * Stage is a 390x845 SVG so it scales with the frame and never overflows.
 */
interface Props { locale?: 'id' | 'en' }
const en = Astro.props.locale === 'en'
const t = {
  tabs: en ? ['ROUTE', 'STOPS', 'PLAN'] : ['RUTE', 'HALTE', 'RENCANA'],
  search: en ? 'Search route name or code' : 'Cari nama atau kode rute',
  legend: en ? 'KEY' : 'KETERANGAN',
  rows: en ? ['Active bus', 'Data > 5 min', 'Stop', 'Corridor'] : ['Bus aktif', 'Data > 5 menit', 'Halte', 'Koridor'],
}
const discs: [string, number, number, string][] = [['K1', 184, 281, '#D60000'], ['K1', 199, 355, '#D60000'], ['K1', 212, 441, '#D60000'], ['K4C', 129, 452, '#7D4305'], ['K4B', 141, 472, '#D62FB4'], ['K2C', 236, 425, '#FFC800'], ['K3A', 219, 512, '#3DB4E8']]
const mono = "'JetBrains Mono', ui-monospace, monospace"
---
<div class="mk-s" style="background:#F7F7F4">
  <svg viewBox="0 0 390 845" preserveAspectRatio="xMidYMid slice" style="position:absolute;inset:0;width:100%;height:100%;font-family:var(--font-sans,Inter,system-ui,sans-serif)">
    <rect width="390" height="845" fill="#F2F3F0"/>
    <!-- basemap -->
    <path d="M0 88H78L168 205 182 262 190 330 176 350 100 365 96 392 108 412 112 468 130 500 150 512 142 560 100 590 60 600 0 640Z" fill="#C2C8CA"/>
    <path d="M200 100C230 140 250 170 280 175M215 130C250 190 280 230 320 210M60 480C90 465 130 462 150 470M280 400C310 380 330 340 390 330" fill="none" stroke="#D3D3D1" stroke-width="1" stroke-dasharray="1.5 3"/>
    <g font-size="11" fill="#57534E" opacity=".75"><text x="232" y="114">Taripa</text><text x="125" y="198">Laiba</text><text x="48" y="260">Tipo</text><text x="224" y="365">Taipa</text><text x="242" y="478">Poboya</text><text x="232" y="574">Biromaru</text></g>
    <!-- corridors -->
    <g fill="none" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
      <path d="M181 230V265L190 300 200 355 207 372 210 425 215 445" stroke="#D60000"/>
      <path d="M210 375L215 400 228 420" stroke="#FFC800"/>
      <path d="M95 365L106 380 103 400 110 415 125 435" stroke="#7D4305"/>
      <path d="M240 505L262 520 270 545 290 565" stroke="#2F9A1A"/>
      <path d="M210 545L235 570 218 548" stroke="#16307F"/>
      <path d="M225 530L245 534" stroke="#D62FB4"/>
    </g>
    <g font-family={mono} font-size="11" font-weight="700" text-anchor="middle" fill="#fff">
      {discs.map(([k, x, y, c]) => <g><circle cx={x} cy={y} r="15" fill={c} stroke="#fff" stroke-width="2"/><text x={x} y={y + 4} fill={k === 'K2C' ? '#fff' : '#fff'}>{k}</text></g>)}
    </g>
    <!-- map controls -->
    <g fill="#fff" stroke="#E7E5E4"><circle cx="360" cy="118" r="18"/><circle cx="360" cy="162" r="18"/></g>
    <g fill="none" stroke="#57534E" stroke-width="1.6" stroke-linecap="round"><circle cx="360" cy="118" r="3.5"/><path d="M360 109v4M360 123v4M351 118h4M365 118h4"/><circle cx="360" cy="162" r="8"/><path d="M352 162h16M360 154c-4 4-4 12 0 16M360 154c4 4 4 12 0 16"/></g>
    <!-- header -->
    <rect width="390" height="88" fill="#F7F7F4"/>
    <rect y="55" width="390" height="33" fill="#F7F7F4"/>
    <path d="M0 55.5H390M0 87.5H390" stroke="#E7E5E4"/>
    <rect x="16" y="14" width="28" height="28" rx="5" fill="#0A0E14"/>
    <path d="M22 36C27 35 28 28 33 27S38 21 38 21" stroke="#1D9CD4" stroke-width="2.2" fill="none" stroke-linecap="round"/><circle cx="22" cy="36" r="2" fill="#F7F7F4" stroke="#1D9CD4"/><circle cx="38" cy="21" r="3" fill="#1D9CD4" stroke="#F7F7F4"/>
    <circle cx="74" cy="28" r="18" fill="#0A0E14"/><circle cx="74" cy="28" r="14" fill="#FFA033"/><text x="74" y="32" text-anchor="middle" font-size="9" font-weight="800" fill="#fff">PALU</text>
    <circle cx="114" cy="28" r="14" fill="#F7F7F4"/><path d="M107 22h14M114 22c-6 2-6 10-1 14s9 1 8-6c-1-3-4-4-7-1" fill="none" stroke="#2D4DDB" stroke-width="2.4" stroke-linecap="round"/>
    <g fill="none" stroke="#57534E" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" transform="translate(0 0)">
      <path d="M286 36l-6-5.4a3.6 3.6 0 015-5.2l1 1 1-1a3.6 3.6 0 015 5.2z" fill="#57534E"/>
      <path d="M317 30v-8M313 27l4 4 4-4M311 34h12"/>
      <g transform="translate(355 21) scale(.583)"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33 1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></g>
    </g>
    <text x="16" y="76" font-family={mono} font-size="11" letter-spacing=".8" fill="#6E6863">11:41 WITA</text>
    <!-- legend (bottom-anchored) -->
    <g transform="translate(0 45)">
      <circle cx="30" cy="481" r="18" fill="#fff" stroke="#E7E5E4"/>
      <g fill="none" stroke="#57534E" stroke-width="1.5" stroke-linecap="round"><circle cx="30" cy="481" r="8"/><path d="M30 477.5h.01M29.5 481h.5v4.5"/></g>
      <rect x="13.5" y="506.5" width="178" height="189" rx="8" fill="#fff" stroke="#E7E5E4"/>
      <text x="25" y="531" font-family={mono} font-size="10" letter-spacing="1" fill="#6E6863">{t.legend}</text>
      <circle cx="35" cy="554" r="10" fill="#1D9CD4" stroke="#fff" stroke-width="2"/><text x="35" y="557.5" text-anchor="middle" font-family={mono} font-size="9" font-weight="700" fill="#fff">K1</text>
      <circle cx="35" cy="584" r="10" fill="#B8BEC0" stroke="#fff" stroke-width="2"/><text x="35" y="587.5" text-anchor="middle" font-family={mono} font-size="9" font-weight="700" fill="#fff">K1</text>
      <circle cx="35" cy="614" r="3.5" fill="#8A93A6"/><circle cx="35" cy="614" r="7" fill="none" stroke="#fff"/>
      <path d="M25 641H46" stroke="#1D9CD4" stroke-width="3" stroke-linecap="round"/>
      <g font-size="12.5" fill="#1C1917"><text x="55" y="558">{t.rows[0]}</text><text x="55" y="588">{t.rows[1]}</text><text x="55" y="618">{t.rows[2]}</text><text x="55" y="645">{t.rows[3]}</text></g>
      <path d="M25 661H179" stroke="#E7E5E4"/><text x="25" y="682" font-family={mono} font-size="10" fill="#6E6863">v0.10.0 · 25c1290</text>
      <g fill="#fff" stroke="#E7E5E4"><rect x="349.500" y="626.500" width="32" height="68" rx="6"/></g><path d="M355 642H376M365.500 632V652M355 677H376" stroke="#0A0E14" stroke-width="2" fill="none"/>
    </g>
    <!-- bottom sheet -->
    <path d="M0 757a14 14 0 0114-14H376a14 14 0 0114 14V845H0Z" fill="#F7F7F4" stroke="#E7E5E4"/>
    <rect x="175" y="767" width="40" height="4" rx="2" fill="#D6D3D1"/>
    <rect x="16" y="790" width="114" height="28" rx="14" fill="#12398C"/>
    <rect x="140" y="790" width="114" height="28" rx="14" fill="#F5F5F4"/>
    <rect x="260" y="790" width="114" height="28" rx="14" fill="#F5F5F4"/>
    <g font-family={mono} font-size="12" font-weight="700" letter-spacing="1.2" text-anchor="middle"><text x="73" y="808" fill="#fff">{t.tabs[0]}</text><text x="197" y="808" fill="#57534E">{t.tabs[1]}</text><text x="317" y="808" fill="#57534E">{t.tabs[2]}</text></g>
    <rect x="16.500" y="827.500" width="358" height="32" rx="6" fill="#FAFAF9" stroke="#E7E5E4"/>
    <text x="28" y="848" font-size="14" fill="#A8A29E">{t.search}</text>
  </svg>
</div>
