---
/**
 * Port of Ayana web dashboard (resources/js/pages/Dashboard.vue + components/dashboard/{StatCard,ActivePregnancyCard,QuickLogRow}.vue
 * + AppSidebar/NavMain + AppSidebarHeader). Source: ~/Documents/Projects/Web/ayana_web (DESIGN.md, resources/css/app.css tokens);
 * brand mark = public/ayana_logo_light.svg (our own product) copied to src/assets/mocks/ayana/logo.svg.
 * Tokens: background hsl(32 40% 98%), card #fff, border hsl(25 20% 88%) @60%, muted hsl(30 20% 95%), primary hsl(352 80% 49%),
 *   sidebar hsl(25 30% 97%) w 16rem, trimester-2 hsl(270 70% 60%), radius cards 16px (rounded-2xl), stat card px16 py12, big card p20,
 *   font Plus Jakarta Sans. Sidebar group labels / item labels = locales/id/dashboard.ts (navigation, userGroupLabels).
 * Stage: 1280x800 design px; 1em below = 1 design px (root font-size = 100cqw/1280), so it scales and never overflows.
 * Data is synthetic (sample name, week 24, counts). The ChildSwitcher row is omitted.
 */
import logo from '../../assets/mocks/ayana/logo.svg'
interface Props { locale?: 'id' | 'en' }
const en = Astro.props.locale === 'en'
const t = en ? {
  groups: [['Overview', ['Dashboard', 'My Subscription']], ['Pregnancy', ['Pregnancy List', 'Pregnancy Timeline']], ['Baby', ['Baby List']], ['Health', ['Nutrition Today', 'Nutrition History', 'Contraception', 'Breastfeeding Guide']]],
  quick: ['Activity', 'Milestone', 'Immunization', 'Pregnancy'], greet: 'Good morning', hello: 'Welcome to Ayana', sub: 'Your Trusted Companion for Mothers & Babies',
  stats: ['Children', 'Pregnancies', 'Milestones Achieved', 'Vaccinations Done'], wk: 'Week 24 · 16 weeks to go', size: 'Your little one is the size of', fruit: 'corn',
  dl: ['length', 'weight', 'left'], det: 'View Details', mgg: 'wks',
} : {
  groups: [['Overview', ['Dashboard', 'Langganan Saya']], ['Kehamilan', ['Daftar Kehamilan', 'Timeline Kehamilan']], ['Bayi', ['Daftar Bayi']], ['Kesehatan', ['Nutrisi Hari Ini', 'Riwayat Nutrisi', 'Kontrasepsi', 'Panduan Menyusui']]],
  quick: ['Aktivitas', 'Milestone', 'Imunisasi', 'Kehamilan'], greet: 'Selamat Pagi', hello: 'Selamat Datang di Ayana', sub: 'Teman Setia Ibu & Buah Hati',
  stats: ['Anak', 'Kehamilan', 'Milestone Tercapai', 'Vaksinasi Selesai'], wk: 'Minggu ke-24 · 16 minggu lagi', size: 'Si Kecil seukuran', fruit: 'jagung',
  dl: ['panjang', 'berat', 'sisa'], det: 'Lihat Detail', mgg: 'mgg',
}
const qc = ['#2563EB', '#059669', '#D97706', '#E11D48']
const ico = ['M3 3h7v7H3zM14 3h7v7h-7zM14 14h7v7h-7zM3 14h7v7H3z', 'M2 5h20v14H2zM2 10h20', 'M12 21s-8-5.2-8-11a4.5 4.5 0 018-2.8A4.5 4.5 0 0120 10c0 5.8-8 11-8 11z', 'M8 2v4M16 2v4M3 6h18v15H3zM3 10h18']
const C = 2 * Math.PI * 25.5
---
<svg viewBox="0 0 1280 800" preserveAspectRatio="xMidYMid slice" style="position:absolute;inset:0;width:100%;height:100%"><foreignObject width="1280" height="800"><div class="ay" style="position:relative;width:1280px;height:800px">
  <aside class="sb">
    <div class="sbh"><img src={logo.src} alt="" width="32" height="32" /><b>Ayana</b></div>
    <div class="nav">
      {t.groups.map(([g, items], gi) => (<div class="grp"><p class="gl">{g}</p>{(items as string[]).map((it, i) => (
        <p class:list={['it', gi === 0 && i === 0 && 'on']}><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d={ico[(gi * 2 + i) % 4]} /></svg>{it}</p>))}</div>))}
    </div>
  </aside>
  <main class="mn">
    <header class="hd"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18"/></svg><span>Dashboard</span></header>
    <div class="ct">
      <div class="ql">{t.quick.map((q, i) => (<span class="chip"><i style={`background:${qc[i]}1F;color:${qc[i]}`}><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d={ico[(i + 1) % 4]} /></svg></i>{q}</span>))}</div>
      <div class="bt">
        <div class="card gr c2">
          <i class="lg"><img src={logo.src} alt="" width="24" height="24" /></i>
          <div><p class="eb">{t.greet}</p><h1>{t.hello}, {en ? 'Sample' : 'Contoh'}!</h1><p class="sm">{t.sub}</p></div>
        </div>
        <div class="card st"><i style="background:hsl(352 80% 49%/.1);color:hsl(352 80% 49%)"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12h.01M15 12h.01M10 16c.5.3 1.2.5 2 .5s1.5-.2 2-.5M12 3a9 9 0 100 18 9 9 0 000-18z"/></svg></i><p class="v">1</p><p class="l">{t.stats[0]}</p></div>
        <div class="card st"><i style="background:hsl(292 84% 60%/.12);color:hsl(292 84% 60%)"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-8-5.2-8-11a4.5 4.5 0 018-2.8A4.5 4.5 0 0120 10c0 5.8-8 11-8 11z"/></svg></i><p class="v">1</p><p class="l">{t.stats[1]}</p></div>
        <div class="card pg c2 r2">
          <div class="pgh"><div>
            <span class="tri"><u></u>Trimester 2</span><p class="sm2">{t.wk}</p>
            <h3>{t.size} <em>{t.fruit}</em></h3></div>
            <div class="pgr"><svg width="56" height="56" viewBox="0 0 56 56" style="transform:rotate(-90deg)"><circle cx="28" cy="28" r="25.5" fill="none" stroke="hsl(25 20% 88%)" stroke-width="5"/><circle cx="28" cy="28" r="25.5" fill="none" stroke="hsl(270 70% 60%)" stroke-width="5" stroke-linecap="round" stroke-dasharray={C} stroke-dashoffset={C * 0.4}/></svg><p>60%</p></div></div>
          <div class="seg"><i style="flex:13"><b style="width:100%;background:hsl(330 80% 60%)"></b></i><i style="flex:14"><b style="width:79%;background:hsl(270 70% 60%)"></b></i><i style="flex:13"><b style="width:0"></b></i></div>
          <dl><div><dt>{t.dl[0]}</dt><dd>30 cm</dd></div><div><dt>{t.dl[1]}</dt><dd>600 g</dd></div><div><dt>{t.dl[2]}</dt><dd>16 {t.mgg}</dd></div></dl>
          <p class="lk">{t.det} ›</p>
        </div>
        <div class="card st"><i style="background:hsl(30 20% 95%);color:hsl(20 20% 22%)"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 7l-8.5 8.5-5-5L2 17M16 7h6v6"/></svg></i><p class="v">12</p><p class="l">{t.stats[2]}</p></div>
        <div class="card st"><i style="background:hsl(352 80% 49%/.1);color:hsl(352 80% 49%)"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4M16 2v4M3 6h18v15H3zM3 10h18"/></svg></i><p class="v">3</p><p class="l">{t.stats[3]}</p></div>
      </div>
    </div>
  </main>
</div></foreignObject></svg>
<style>
  .ay { display: flex; flex-direction: row; overflow: hidden; font-size: 16px; line-height: 1.3; font-family: 'Plus Jakarta Sans', var(--font-sans, system-ui), sans-serif; font-weight: 400; background: hsl(32 40% 98%); color: hsl(20 20% 12%); }
  .ay * { box-sizing: border-box; }
  .ay svg { display: block; border: 0; outline: 0; }
  .ay .st i { display: grid; place-items: center; }
  .ay p, .ay h1, .ay h3 { margin: 0; }
  .ay .sb { width: 256px; flex: none; background: hsl(25 30% 97%); border-right: 1px solid hsl(25 20% 88%); display: flex; flex-direction: column; overflow: hidden; color: hsl(20 20% 22%); }
  .ay .sbh { height: 64px; display: flex; align-items: center; gap: 8px; padding: 0 16px; border-bottom: 1px solid hsl(25 20% 88%/.7); font-size: 16px; }
  .ay .sbh img { width: 32px; height: 32px; }
  .ay .nav { padding: 8px; display: flex; flex-direction: column; gap: 4px; }
  .ay .grp { padding: 8px 0 4px; }
  .ay .gl { font-size: 12px; height: 32px; line-height: 16px; padding: 8px; color: hsl(20 20% 22%/.7); }
  .ay .it { display: flex; align-items: center; gap: 8px; height: 32px; padding: 0 8px; font-size: 14px; border-radius: 6px; white-space: nowrap; }
  .ay .it.on { background: hsl(30 25% 93%); font-weight: 500; }
  .ay .mn { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .ay .hd { height: 64px; flex: none; display: flex; align-items: center; gap: 12px; padding: 0 16px; border-bottom: 1px solid hsl(25 20% 88%/.7); font-size: 14px; }
  .ay .ct { padding: 32px; display: flex; flex-direction: column; gap: 16px; overflow: hidden; }
  .ay .ql { display: flex; gap: 8px; }
  .ay .chip { display: inline-flex; align-items: center; gap: 8px; height: 40px; padding: 0 12px 0 8px; background: #fff; border: 1px solid hsl(25 20% 88%/.6); border-radius: 12px; font-size: 14px; font-weight: 500; }
  .ay .chip i { width: 24px; height: 24px; border-radius: 8px; display: grid; place-items: center; }
  .ay .bt { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .ay .c2 { grid-column: span 2; } .ay .r2 { grid-row: span 2; }
  .ay .card { background: #fff; border: 1px solid hsl(25 20% 88%/.6); border-radius: 16px; min-width: 0; }
  .ay .gr { display: flex; align-items: center; gap: 12px; padding: 16px 20px; }
  .ay .lg { width: 44px; height: 44px; border-radius: 12px; background: hsl(352 80% 49%/.1); display: grid; place-items: center; flex: none; }
  .ay .eb { font-size: 11px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: hsl(352 80% 49%); }
  .ay h1 { font-size: 24px; line-height: 32px; font-weight: 700; letter-spacing: -.025em; margin-top: 2px; white-space: nowrap; }
  .ay .sm { font-size: 12px; color: hsl(20 10% 43%); }
  .ay .st { padding: 12px 16px; }
  .ay .st i { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 8px; margin-bottom: 8px; }
  .ay .v { font-size: 24px; line-height: 32px; font-weight: 800; letter-spacing: -.025em; }
  .ay .l { font-size: 14px; line-height: 20px; margin-top: 4px; color: hsl(20 10% 43%); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ay .pg { padding: 24px; }
  .ay .pgh { display: flex; justify-content: space-between; gap: 16px; margin-bottom: 16px; }
  .ay .tri { display: inline-flex; align-items: center; gap: 6px; padding: 2px 8px; border-radius: 6px; font-size: 10px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: hsl(270 70% 60%); background: hsl(270 70% 60%/.12); }
  .ay .tri u { width: 6px; height: 6px; border-radius: 50%; background: hsl(270 70% 60%); }
  .ay .sm2 { margin-top: 8px; font-size: 11px; color: hsl(20 10% 43%); }
  .ay h3 { margin-top: 4px; font-size: 24px; line-height: 1.25; font-weight: 700; letter-spacing: -.025em; }
  .ay h3 em { font-style: italic; font-weight: 500; letter-spacing: 0; color: hsl(270 70% 60%); }
  .ay .pgr { flex: none; } .ay .pgr p { margin-top: 4px; text-align: center; font-size: 11px; font-weight: 700; color: hsl(270 70% 60%); }
  .ay .seg { display: flex; gap: 4px; margin-bottom: 16px; }
  .ay .seg i { height: 6px; border-radius: 9px; background: hsl(30 20% 95%); overflow: hidden; display: block; }
  .ay .seg b { display: block; height: 100%; border-radius: 9px; }
  .ay dl { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin: 0; }
  .ay dl div { background: hsl(30 20% 95%/.5); border-radius: 8px; padding: 8px 12px; }
  .ay dt { font-size: 10px; letter-spacing: .025em; text-transform: uppercase; color: hsl(20 10% 43%); }
  .ay dd { margin: 2px 0 0; font-size: 14px; font-weight: 800; letter-spacing: -.025em; }
  .ay .lk { margin-top: 16px; font-size: 14px; font-weight: 500; color: hsl(352 80% 49%); }
</style>
