---
/**
 * Port of the Lontara Flutter app home screen (lontara_ui/lib/features/main/home/home_page.dart + wrapper_page.dart)
 * with lontara_ui_kit tokens (private repo daengweb/lontara_ui_kit, read via gh): LOColors, LOTextStyle (Poppins,
 * body 13, headerLarge 16/600, headerMedium 14, bodySmall 12), LOLocationPicker, LOMenuCard, LOActivityCTA, LOButton,
 * LOIcons svgs. ScreenUtil design size is 375x812, so 1em here = 1 dp (root font-size = width/375).
 * Layout facts (dp): header 0..203 blue #0DA7EF; picker top 90 / inset 16 / pad 16 / r16 / field 48 r8;
 * menu grid 268 tall, 2 rows x 4 visible cols, cell 90 wide, circle 52 gradient, label 12/500;
 * CTA card pad 16 r12; bottom nav 56 + inset, icons 24, labels 14 active / 12 idle.
 * Synthetic: user name "Hai, Rahmat" and NOP/name are the app's own placeholder strings (home_page.dart), not people.
 * Pattern art is redrawn (generic city/mountain silhouette), not the shipped PNG. Poppins falls back if not installed.
 */
const I = {
  file: ['0 0 35 34', 'M7.035 7.564c-.586 0-1.06.477-1.06 1.063v20.92c0 .586.474 1.062 1.06 1.062h16.733c.586 0 1.06-.476 1.06-1.062l.117-16.344c.005-.586-5.363-5.639-5.949-5.639zm3.049 3.364h4.28c.43 0 .775.345.775.775 0 .43-.346.776-.776.776h-4.279a.773.773 0 01-.775-.776c0-.43.345-.775.775-.775zm-.018 4.2h8.518a.777.777 0 110 1.554h-8.518a.777.777 0 110-1.553zm7.9 5.245c.43 0 .778.346.778.775v2.323h2.244c.43 0 .776.345.776.775 0 .43-.346.775-.776.775h-2.244v2.22c0 .43-.347.775-.777.775a.773.773 0 01-.776-.776v-2.219h-2.295a.773.773 0 01-.775-.775c0-.43.346-.775.775-.775h2.295v-2.323c0-.43.346-.775.776-.775z'],
  warehouse: ['0 0 35 34', 'M32.375 24.438h-1.063V7.69l1.285-.276a1.063 1.063 0 10-.445-2.078l-29.75 6.375a1.062 1.062 0 00.447 2.078l.838-.18v10.829H2.625a1.062 1.062 0 100 2.125h29.75a1.063 1.063 0 000-2.125zm-7.438 0H10.063v-2.125h14.876v2.125zm0-4.25H10.063v-2.125h14.876v2.125z'],
  building: ['0 0 35 34', 'M32.34 27.625h-2.09V12.75a2.125 2.125 0 00-2.125-2.125h-5.843a.53.53 0 00-.532.531v16.47h-2.125V4.304a2.182 2.182 0 00-.818-1.727 2.125 2.125 0 00-2.486-.092L5.696 9.563a2.125 2.125 0 00-.946 1.771v16.291H2.661a1.086 1.086 0 00-1.098.992 1.062 1.062 0 001.062 1.133h29.75a1.062 1.062 0 001.063-1.133 1.086 1.086 0 00-1.099-.992zm-21.746-3.187A1.062 1.062 0 019.461 25.5a1.087 1.087 0 01-.992-1.1V22.35a1.088 1.088 0 01.992-1.099 1.063 1.063 0 011.133 1.063v2.125zm0-7.438a1.062 1.062 0 01-1.133 1.063 1.088 1.088 0 01-.992-1.1v-2.052a1.088 1.088 0 01.992-1.098 1.063 1.063 0 011.133 1.062V17zm5.313 7.438a1.062 1.062 0 01-1.133 1.062 1.086 1.086 0 01-.992-1.097V22.35a1.088 1.088 0 01.992-1.098 1.063 1.063 0 011.133 1.063v2.124zm0-7.438a1.062 1.062 0 01-1.133 1.063 1.088 1.088 0 01-.992-1.097V14.91a1.088 1.088 0 01.992-1.097 1.063 1.063 0 011.133 1.063V17z'],
  garage: ['0 0 35 34', 'M32.375 25.5h-1.063V13.105a2.126 2.126 0 00-.945-1.768L18.679 3.545a2.125 2.125 0 00-2.357 0L4.634 11.337a2.124 2.124 0 00-.947 1.768V25.5H2.625a1.062 1.062 0 100 2.125h29.75a1.062 1.062 0 100-2.125zM18.562 17H26v3.188h-7.438V17zm-2.125 3.188H9V17h7.438v3.188zM9 22.313h7.438V25.5H9v-3.187zm9.563 0H26V25.5h-7.438v-3.187z'],
  book: ['0 0 35 35', 'M28.829 5.93L11.53 2.877A2.125 2.125 0 009.07 4.6L5.117 27.045a2.125 2.125 0 001.727 2.461l17.298 3.055a2.122 2.122 0 002.463-1.727l3.95-22.445a2.125 2.125 0 00-1.727-2.458zm-9.998 12.26a1.063 1.063 0 01-1.231.862l-5.512-.973a1.063 1.063 0 01.37-2.088l5.51.968a1.061 1.061 0 01.863 1.232zm6.242-3.21a1.062 1.062 0 01-1.231.86l-11.023-1.946a1.063 1.063 0 11.37-2.093l11.023 1.947a1.065 1.065 0 01.865 1.231h-.004zm.737-4.187a1.063 1.063 0 01-1.231.862L13.556 9.708a1.062 1.062 0 11.369-2.092l11.023 1.946a1.062 1.062 0 01.866 1.23h-.004z'],
  folder: ['0 0 34 34', 'M32.54 14.694a2.125 2.125 0 00-1.727-.882h-2.125v-2.124a2.125 2.125 0 00-2.125-2.126h-9.208L13.672 6.8a2.143 2.143 0 00-1.275-.425H5.312A2.125 2.125 0 003.188 8.5v19.125a1.063 1.063 0 001.063 1.063h23.787a1.063 1.063 0 001.008-.727l3.784-11.351a2.132 2.132 0 00-.29-1.916zM12.396 8.5l3.683 2.762c.368.275.815.424 1.275.425h9.207v2.126h-7.114c-.42 0-.83.124-1.18.357l-2.656 1.768H9.22a2.117 2.117 0 00-1.974 1.336l-1.934 4.834V8.5h7.085z'],
  filedown: ['0 0 34 34', 'M28.377 10.936l-7.438-7.438a1.062 1.062 0 00-.752-.31H7.438a2.125 2.125 0 00-2.125 2.124v23.375a2.125 2.125 0 002.125 2.125h19.125a2.125 2.125 0 002.125-2.125v-17a1.063 1.063 0 00-.31-.751zm-7.438 11.066l-3.187 3.187a1.061 1.061 0 01-1.504 0l-3.187-3.187a1.063 1.063 0 111.503-1.504l1.373 1.375v-5.936a1.062 1.062 0 112.126 0v5.936l1.373-1.375a1.063 1.063 0 111.503 1.504zm-.752-10.314V5.843l5.844 5.843h-5.843z'],
  wallet: ['0 0 34 34', 'M28.688 9.563H7.438a1.062 1.062 0 010-2.126H25.5a1.063 1.063 0 000-2.125H7.437A3.187 3.187 0 004.25 8.5v17a3.188 3.188 0 003.188 3.188h21.25a2.125 2.125 0 002.125-2.125V11.688a2.125 2.125 0 00-2.125-2.126zm-4.782 10.624a1.594 1.594 0 110-3.187 1.594 1.594 0 010 3.188z'],
}
const menu: [string, string, keyof typeof I, string][] = [
  ['Buat Pajak<br>Baru', 'b', 'file', ''], ['Cek Pajak<br>PBB', 'o', 'warehouse', ''],
  ['Pelayanan<br>PBB', 'n', 'building', ''], ['Cek BPHTB', 'g', 'garage', ''],
  ['E-SPTPD', 'o', 'book', ''], ['Cek Pajak Lainnya', 'b', 'folder', ''],
  ['E-SPPT', 'n', 'filedown', ''], ['Pembayaran', 'g', 'wallet', ''],
]
---
<div class="lt">
  <div class="lt-hd">
    <svg class="lt-pat" viewBox="0 0 512 164" preserveAspectRatio="none" aria-hidden="true">
      <g fill="#0A86C8" fill-opacity=".55"><path d="M145 80 Q160 20 190 15 Q215 15 238 78 Q222 60 210 70 Q195 40 180 70 Q160 62 145 80Z"/><path d="M246 98 Q262 56 278 60 Q300 62 312 100 Q298 80 288 92Z"/></g>
      <g fill="#0C95DD"><rect x="30" y="76" width="96" height="88"/><rect x="330" y="0" width="92" height="164"/><rect x="430" y="78" width="82" height="86"/></g>
      <g fill="#0B88C9" fill-opacity=".6"><rect x="74" y="88" width="16" height="10"/><rect x="100" y="88" width="16" height="10"/><rect x="74" y="112" width="16" height="10"/><rect x="100" y="112" width="16" height="10"/><rect x="374" y="18" width="16" height="10"/><rect x="398" y="18" width="16" height="10"/><rect x="374" y="42" width="16" height="10"/><rect x="398" y="42" width="16" height="10"/><rect x="374" y="66" width="16" height="10"/><rect x="398" y="66" width="16" height="10"/></g>
    </svg>
    <div class="lt-sb"><span>09:41</span><span class="lt-bat"></span></div>
    <div class="lt-who">
      <span class="lt-av"><svg viewBox="0 0 24 24" width="24" height="24"><path fill="#0C7BEE" d="M12 2C9.38 2 7.25 4.13 7.25 6.75c0 2.57 2.01 4.65 4.63 4.74.08-.01.16-.01.22 0h.07a4.738 4.738 0 004.58-4.74C16.75 4.13 14.62 2 12 2zM17.08 14.15c-2.79-1.86-7.34-1.86-10.15 0-1.27.85-1.97 2-1.97 3.23s.7 2.37 1.96 3.21C8.32 21.53 10.16 22 12 22c1.84 0 3.68-.47 5.08-1.41 1.26-.85 1.96-1.99 1.96-3.23-.01-1.23-.7-2.37-1.96-3.21z"/></svg></span>
      <span class="lt-hai">Hai, <b>Rahmat</b></span>
    </div>
    <div class="lt-white"></div>
    <div class="lt-pick">
      <p class="lt-lbl">Pilih Pemerintah Daerah:</p>
      <div class="lt-fld">
        <svg viewBox="0 0 18 18" width="18" height="18"><path fill="#034DA6" d="M15.465 6.338C14.677 2.872 11.655 1.312 9 1.312h-.008c-2.647 0-5.677 1.553-6.465 5.018-.877 3.87 1.493 7.147 3.638 9.21A4.077 4.077 0 009 16.688c1.02 0 2.04-.383 2.827-1.148 2.145-2.063 4.515-5.332 3.638-9.202zM9 10.095a2.362 2.362 0 110-4.724 2.362 2.362 0 010 4.724z"/></svg>
        <span class="lt-none">Belum Ada Pilihan</span><span class="lt-pil">Pilih</span>
      </div>
    </div>
  </div>

  <div class="lt-grid">
    {[0, 2, 4, 6].map((c) => (
      <div class="lt-col">
        {[0, 1].map((r) => { const [label, g, ic] = menu[c + r]; return (
          <div class="lt-mc"><span class={`lt-ci g-${g}`}><svg viewBox={I[ic][0]} width="34" height="34"><path fill="#fff" d={I[ic][1]} /></svg></span><span class="lt-ml" set:html={label}></span></div>
        )})}
      </div>
    ))}
  </div>

  <div class="lt-sec">
    <hr />
    <div class="lt-cta">
      <div class="lt-ct"><span class="lt-ci g-g sm"><svg viewBox="0 0 34 34" width="16" height="16"><path fill="#fff" d={I.wallet[1]} /></svg></span><span class="lt-t13">Segera Lakukan Pembayaran - PBB</span></div>
      <p class="lt-nop">NOP: 73.05.010.001.001.0012.0</p>
      <p class="lt-nm">Nama PBB</p>
      <span class="lt-btn">Lanjutkan Pembayaran</span>
    </div>
  </div>

  <div class="lt-nav">
    <span class="on"><svg viewBox="0 0 24 24" width="24" height="24"><path fill="currentColor" d="M20.83 8.01l-6.55-5.24C13 1.75 11 1.74 9.73 2.76L3.18 8.01c-.94.75-1.51 2.25-1.31 3.43l1.26 7.54C3.42 20.67 4.99 22 6.7 22h10.6c1.69 0 3.29-1.36 3.58-3.03l1.26-7.54c.18-1.17-.39-2.67-1.31-3.42zM12.75 18c0 .41-.34.75-.75.75s-.75-.34-.75-.75v-3c0-.41.34-.75.75-.75s.75.34.75.75v3z"/></svg>Home</span>
    <span><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 22h6c5 0 7-2 7-7V9c0-5-2-7-7-7H9C4 2 2 4 2 9v6c0 5 2 7 7 7z"/><path d="M7.33 14.49l2.38-3.09c.34-.44.97-.52 1.41-.18l1.83 1.44c.44.34 1.07.26 1.41-.17l2.31-2.98"/></svg>Aktivitas</span>
    <span><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 12.2h7M8 16.2h4.38M10 6h4c2 0 2-1 2-2 0-2-1-2-2-2h-4C9 2 8 2 8 4s1 2 2 2z"/><path d="M16 4.02c3.33.18 5 1.41 5 5.98v6c0 4-1 6-6 6H9c-5 0-6-2-6-6v-6c0-4.56 1.67-5.8 5-5.98"/></svg>Kelola</span>
    <span><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12.16 10.87c-.1-.01-.22-.01-.33 0a4.42 4.42 0 01-4.27-4.43C7.56 3.99 9.54 2 12 2a4.435 4.435 0 01.16 8.87zM7.16 14.56c-2.42 1.62-2.42 4.26 0 5.87 2.75 1.84 7.26 1.84 10.01 0 2.42-1.62 2.42-4.26 0-5.87-2.74-1.83-7.25-1.83-10.01 0z"/></svg>Profile</span>
  </div>
</div>

<style>
  /* 1px = 1 dp of the 375x812 design */
  .lt { position: absolute; left: 0; top: 0; overflow: hidden; background: #fff; color: #191931; font-family: Poppins, Inter, system-ui, sans-serif; font-weight: 400; font-size: 13px; line-height: 1.5; width: 375px; height: 812px; transform-origin: 0 0; transform: scale(tan(atan2(100cqw, 375px))); }
  .lt, .lt * { box-sizing: border-box; }
  .lt p { margin: 0; }
  .lt-hd { position: absolute; left: 0; right: 0; top: 0; height: 203px; background: #0DA7EF; }
  .lt-pat { position: absolute; left: 0; top: 24px; width: 100%; height: 120px; }
  .lt-sb { position: absolute; left: 0; right: 0; top: 0; height: 24px; display: flex; justify-content: space-between; align-items: center; padding: 0 16px; font-size: 12px; font-weight: 600; color: #fff; }
  .lt-bat { width: 20px; height: 10px; border: 1.5px solid #fff; border-radius: 3px; }
  .lt-who { position: absolute; left: 16px; top: 36px; display: flex; align-items: center; gap: 12px; }
  .lt-av { width: 40px; height: 40px; border-radius: 50%; background: #FAFAFC; display: grid; place-items: center; }
  .lt-hai { color: #fff; font-size: 14px; font-weight: 400; } .lt-hai b { font-size: 16px; font-weight: 600; }
  .lt-white { position: absolute; left: 0; right: 0; top: 140px; height: 63px; background: #fff; }
  .lt-pick { position: absolute; left: 16px; right: 16px; top: 90px; padding: 16px; background: #fff; border: 1px solid #E9EAF2; border-radius: 16px; box-shadow: 0 10px 20px #08214614; }
  .lt-lbl { font: 400 13px/1.5 Inter, system-ui, sans-serif; color: #797990; margin-bottom: 12px !important; }
  .lt-fld { height: 48px; display: flex; align-items: center; gap: 8px; padding: 12px; background: #FAFAFC; border: 1px solid #E9EAF2; border-radius: 8px; font: 600 14px/1.5 Inter, system-ui, sans-serif; }
  .lt-none { flex: 6; color: #797990; white-space: nowrap; overflow: hidden; } .lt-pil { flex: 1; color: #0C7BEE; margin-left: 8px; }
  .lt-grid { position: absolute; left: 0; right: 0; top: 203px; height: 268px; display: flex; padding: 16px; gap: 0; overflow: hidden; }
  .lt-col { width: 90px; flex: none; display: flex; flex-direction: column; gap: 16px; }
  .lt-mc { flex: 1; min-height: 0; display: flex; flex-direction: column; align-items: center; padding-top: 8px; gap: 8px; }
  .lt-ci { width: 52px; height: 52px; padding: 8px; border-radius: 50%; display: grid; place-items: center; flex: none; }
  .lt-ci.sm { width: 24px; height: 24px; padding: 4px; }
  .g-b { background: linear-gradient(135deg, #0C95F0, #0C30F07F), #fff; } .g-o { background: linear-gradient(135deg, #FB4D3D, #FBA33D7F), #fff; }
  .g-n { background: linear-gradient(135deg, #345995, #39309E7F), #fff; } .g-g { background: linear-gradient(135deg, #03CEA4, #03A9CE7F), #fff; }
  .lt-ml { font-size: 12px; font-weight: 500; line-height: 1.5; text-align: center; color: #191931; }
  .lt-sec { position: absolute; left: 0; right: 0; top: 471px; padding: 16px; }
  .lt-sec hr { border: 0; border-top: 1px solid #E9EAF2; margin: 0 0 24px; }
  .lt-cta { padding: 16px; background: #fff; border: 1px solid #E9EAF2; border-radius: 12px; box-shadow: 0 8px 10px #08214614; }
  .lt-ct { display: flex; align-items: center; gap: 8px; margin-bottom: 18px; }
  .lt-t13 { font-size: 13px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lt-nop { font-size: 16px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lt-nm { font-size: 13px; color: #ABABBB; margin-top: 4px !important; margin-bottom: 16px !important; }
  .lt-btn { display: grid; place-items: center; height: 48px; border-radius: 12px; background: #0C7BEE; color: #fff; font: 600 13px/1 Inter, system-ui, sans-serif; }
  .lt-nav { position: absolute; left: 0; right: 0; bottom: 0; height: 76px; padding: 0 0 20px; background: #fff; box-shadow: 0 -1px 4px #0000001a; display: flex; }
  .lt-nav span { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; font-size: 12px; color: #797990; line-height: 1.2; }
  .lt-nav .on { color: #0C7BEE; font-size: 14px; }
</style>
