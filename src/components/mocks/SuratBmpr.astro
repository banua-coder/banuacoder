---
/**
 * Port of Surat-BMPR-Mobile (Flutter, bloc) Home tab. Sources:
 *  lib/features/home/presentation/pages/home_page.dart, widgets/statistic_card.dart, features/main/presentation/pages/main_page.dart,
 *  lib/core/i18n/strings*.i18n.json, and the public banua-coder/bimatarung-design-system (BTColors, BTTextStyle = Inter, ScreenSize 411dp).
 * Layout facts (dp; 411dp wide = 100cqw): gradient #2AC7D1 -> #030F6B (primary from 11%), AppBar transparent 56 with 40dp avatar + welcome (Inter 14)
 * + name (Inter 16/600); body #F7F7F7 radius 26 on top; search pill (radius 100, border #979C9E, hint "Cari Surat", pad 16/16/16);
 * list pad H20 V16; headings Inter 18/600; grid 3 cols, spacing 0.1*width (41.1) x 20, square cells; StatisticCard pad 8, r8, 1px #979C9E,
 * 16dp coloured dot (2dp pad, 12dp icon), title Inter 16/600, value Inter 36/700; BottomNavigationBar #F7F9FA, fixed,
 * active #030F6B 700 / inactive #CDCFD0 500, label Inter 14.
 * Synthetic: avatar, name, counts. Variant drawn: non-operator (inbox + outbox grids, five tabs). FAB omitted (colour not in source read).
 * Search field height (48) and heading colour are estimates, not measured.
 */
interface Props { locale?: 'id' | 'en' }
const en = Astro.props.locale === 'en'
const t = en
  ? { welcome: 'Welcome,', name: 'Sample User', hint: 'Search Letter', inbox: 'Inbox', outbox: 'Outgoing Mail', total: 'Total', proc: 'On Progress', done: 'Done', tabs: ['Home', 'Notifications', 'Inbox', 'Sent', 'Profile'] }
  : { welcome: 'Selamat Datang,', name: 'Nama Pengguna', hint: 'Cari Surat', inbox: 'Surat Masuk', outbox: 'Surat Keluar', total: 'Total', proc: 'Proses', done: 'Selesai', tabs: ['Beranda', 'Notifikasi', 'Inbox', 'Terkirim', 'Profil'] }
const grids = [
  { h: t.inbox, c: [[t.total, 24, '#030F6B', 'mail'], [t.proc, 6, '#FF5247', 'clock'], [t.done, 18, '#12B76A', 'check']] },
  { h: t.outbox, c: [[t.total, 12, '#030F6B', 'send'], [t.proc, 4, '#FF5247', 'clock'], [t.done, 8, '#12B76A', 'check']] },
]
---
<div class="bm">
  <svg class="bm-bg" viewBox="0 0 411 890" preserveAspectRatio="none"><defs><linearGradient id="bmg" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="205.5" y2="890"><stop offset="0" stop-color="#2AC7D1"/><stop offset=".111" stop-color="#030F6B"/></linearGradient></defs><rect width="411" height="890" fill="url(#bmg)"/></svg>
  <div class="bm-sb"><span>09:41</span><span class="bm-bat"></span></div>
  <div class="bm-ab">
    <span class="bm-av"><svg viewBox="0 0 24 24"><circle cx="12" cy="9" r="4" fill="#fff"/><path d="M4 21c0-4.500 3.500-7 8-7s8 2.500 8 7z" fill="#fff"/></svg></span>
    <div><p class="bm-w">{t.welcome}</p><p class="bm-n">{t.name}</p></div>
  </div>
  <div class="bm-body">
    <div class="bm-search"><span>{t.hint}</span><svg viewBox="0 0 24 24"><circle cx="10.500" cy="10.500" r="6.500" fill="none" stroke="#090A0A" stroke-width="1.800"/><path d="M15.500 15.500L21 21" stroke="#090A0A" stroke-width="1.800" stroke-linecap="round"/></svg></div>
    <div class="bm-list">
      {grids.map((g, gi) => (
        <Fragment>
          <p class="bm-h">{g.h}</p>
          <div class="bm-grid">
            {g.c.map(([title, v, col, ic]) => (
              <div class="bm-card">
                <div class="bm-row"><i style={`background:${col}`}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.200" stroke-linecap="round" stroke-linejoin="round">
                    {ic === 'mail' && <Fragment><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></Fragment>}
                    {ic === 'clock' && <Fragment><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></Fragment>}
                    {ic === 'check' && <path d="M5 12.500l4.500 4.500L19 7.500"/>}
                    {ic === 'send' && <path d="M21 3L3 10l7 3 3 7zM10 13l11-10"/>}
                  </svg></i><span>{title}</span></div>
                <p class="bm-v">{v}</p>
              </div>
            ))}
          </div>
        </Fragment>
      ))}
    </div>
  </div>
  <div class="bm-nav">
    {t.tabs.map((l, i) => (
      <span class:list={[i === 0 && 'on']}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.800" stroke-linejoin="round" stroke-linecap="round">
          {i === 0 && <path d="M3 11l9-8 9 8M5 9.500V21h5v-6h4v6h5V9.500" fill="currentColor" stroke-width="1.200"/>}
          {i === 1 && <path d="M6 17v-6a6 6 0 0 1 12 0v6l2 2H4zM10 21h4"/>}
          {i === 2 && <path d="M3 13l3-8h12l3 8v6H3zM3 13h5l1 3h6l1-3h5"/>}
          {i === 3 && <path d="M21 3L3 10l7 3 3 7zM10 13l11-10"/>}
          {i === 4 && <Fragment><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.500-6 8-6s8 2 8 6"/></Fragment>}
        </svg>{l}
      </span>
    ))}
  </div>
</div>
<style>
  .bm { --d: calc(100cqw / 411); position: absolute; inset: 0; display: flex; flex-direction: column; overflow: hidden; color: #1f1f1f; font: 400 calc(14 * var(--d))/1.25 Inter, var(--font-sans, system-ui, sans-serif); }
  .bm * { box-sizing: border-box; }
  .bm p { margin: 0; }
  .bm-bg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .bm-sb { position: relative; height: calc(24 * var(--d)); display: flex; justify-content: space-between; align-items: center; padding: 0 calc(16 * var(--d)); color: #fff; font-size: calc(11 * var(--d)); font-weight: 600; flex: none; }
  .bm-bat { width: calc(16 * var(--d)); height: calc(8 * var(--d)); border: calc(1.200 * var(--d)) solid #fff; border-radius: calc(2 * var(--d)); }
  .bm-ab { position: relative; height: calc(56 * var(--d)); display: flex; align-items: center; gap: calc(8 * var(--d)); padding: 0 calc(16 * var(--d)); color: #fff; flex: none; }
  .bm-av { width: calc(40 * var(--d)); height: calc(40 * var(--d)); border-radius: 50%; background: #979C9E; overflow: hidden; display: grid; place-items: center; flex: none; }
  .bm-av svg { width: 70%; height: 70%; margin-top: 15%; }
  .bm-w { font-size: calc(14 * var(--d)); }
  .bm-n { font-size: calc(16 * var(--d)); font-weight: 600; }
  .bm-body { position: relative; flex: 1; min-height: 0; background: #F7F7F7; border-radius: calc(26 * var(--d)) calc(26 * var(--d)) 0 0; overflow: hidden; padding-top: calc(16 * var(--d)); }
  .bm-search { margin: 0 calc(16 * var(--d)); height: calc(48 * var(--d)); border: 1px solid #979C9E; border-radius: calc(100 * var(--d)); display: flex; align-items: center; justify-content: space-between; padding: 0 calc(12 * var(--d)) 0 calc(16 * var(--d)); color: #979C9E; font-size: calc(14 * var(--d)); }
  .bm-search svg { width: calc(24 * var(--d)); height: calc(24 * var(--d)); }
  .bm-list { padding: calc(16 * var(--d)) calc(20 * var(--d)); }
  .bm-h { font-size: calc(18 * var(--d)); font-weight: 600; margin-bottom: calc(8 * var(--d)); }
  .bm-grid { display: grid; grid-template-columns: repeat(3, 1fr); column-gap: calc(41.1 * var(--d)); margin-bottom: calc(24 * var(--d)); }
  .bm-card { aspect-ratio: 1; padding: calc(8 * var(--d)); border: 1px solid #979C9E; border-radius: calc(8 * var(--d)); min-width: 0; }
  .bm-row { display: flex; align-items: center; gap: calc(4 * var(--d)); min-width: 0; }
  .bm-row i { width: calc(16 * var(--d)); height: calc(16 * var(--d)); padding: calc(2 * var(--d)); border-radius: 50%; display: block; flex: none; }
  .bm-row svg { width: 100%; height: 100%; display: block; }
  .bm-row span { font-size: calc(16 * var(--d)); font-weight: 600; white-space: nowrap; transform-origin: left; }
  .bm-v { margin-top: calc(4 * var(--d)) !important; font-size: calc(36 * var(--d)); font-weight: 700; line-height: 1.2; }
  .bm-nav { position: relative; height: calc(56 * var(--d)); flex: none; display: flex; background: #F7F9FA; }
  .bm-nav span { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: calc(3 * var(--d)); font-size: calc(14 * var(--d)); font-weight: 500; color: #CDCFD0; min-width: 0; white-space: nowrap; }
  .bm-nav span.on { color: #030F6B; font-weight: 700; }
  .bm-nav svg { width: calc(24 * var(--d)); height: calc(24 * var(--d)); }
</style>
